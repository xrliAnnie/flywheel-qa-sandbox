+describe("launchctl voice supervisor", () => {
+	function clockOptions(overrides: Record<string, unknown> = {}) {
+		let current = 0;
+		return {
+			stopGraceMs: 2_000,
+			forceSettleMs: 2_000,
+			pollIntervalMs: 1_000,
+			now: () => current,
+			sleep: async (ms: number) => {
+				current += ms;
+			},
+			...overrides,
+		};
+	}
+
+	it("waits through a rebound pid until the job is truly not running", async () => {
+		let prints = 0;
+		const run = vi.fn(async (_file: string, args: readonly string[]) => {
+			if (args[0] !== "print") return "";
+			prints += 1;
+			if (prints <= 3) return "state = running\npid = 100\n";
+			if (prints === 4) return "state = running\npid = 200\n";
+			throw Object.assign(new Error("not running"), { code: 113 });
+		});
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions(),
+		);
+
+		expect(await supervisor.stop()).toBe("forced");
+		expect(run).toHaveBeenCalledWith("/bin/launchctl", [
+			"kill",
+			"SIGKILL",
+			"gui/501/com.xrli.raya.voice",
+		]);
+		expect(prints).toBe(5);
+	});
+
+	it("returns force_failed while any old or rebound instance remains running", async () => {
+		const run = vi.fn(async (_file: string, args: readonly string[]) =>
+			args[0] === "print" ? "state = running\npid = 100\n" : "",
+		);
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions(),
+		);
+
+		expect(await supervisor.stop()).toBe("force_failed");
+		expect(run).toHaveBeenCalledWith("/bin/launchctl", [
+			"kill",
+			"SIGKILL",
+			"gui/501/com.xrli.raya.voice",
+		]);
+	});
+
+	it("returns signaled without SIGKILL once SIGTERM converges", async () => {
+		let prints = 0;
+		const run = vi.fn(async (_file: string, args: readonly string[]) => {
+			if (args[0] !== "print") return "";
+			prints += 1;
+			if (prints === 1) return "state = running\npid = 100\n";
+			throw Object.assign(new Error("not running"), { code: 113 });
+		});
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions(),
+		);
+
+		expect(await supervisor.stop()).toBe("signaled");
+		expect(
+			run.mock.calls.some(([, args]) => args[1] === "SIGKILL"),
+		).toBe(false);
+	});
+
+	it("maps an absent SIGTERM target to absent", async () => {
+		const absent = Object.assign(new Error("not running"), { code: 113 });
+		const run = vi.fn(async (_file: string, args: readonly string[]) => {
+			if (args[0] === "print" || args[1] === "SIGTERM") throw absent;
+			return "";
+		});
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions(),
+		);
+
+		expect(await supervisor.stop()).toBe("absent");
+	});
+
+	it("retries a flapping pre-marker rebound and requires two stable pid samples", async () => {
+		let prints = 0;
+		const run = vi.fn(async (_file: string, args: readonly string[]) => {
+			if (args[0] !== "print") return "";
+			prints += 1;
+			if (prints === 1) return "state = running\npid = 100\n";
+			if (prints === 2)
+				throw Object.assign(new Error("rebound left"), { code: 113 });
+			return "state = running\npid = 200\n";
+		});
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions({ startAttempts: 2 }),
+		);
+
+		expect(await supervisor.start()).toBe("launched");
+		expect(
+			run.mock.calls.filter(([, args]) => args[0] === "kickstart"),
+		).toHaveLength(2);
+		expect(prints).toBe(4);
+	});
+
+	it("reports requested_but_down after all stable-start attempts flap", async () => {
+		let prints = 0;
+		const run = vi.fn(async (_file: string, args: readonly string[]) => {
+			if (args[0] !== "print") return "";
+			prints += 1;
+			return prints % 2 === 1
+				? "state = running\npid = 100\n"
+				: Promise.reject(
+						Object.assign(new Error("rebound left"), { code: 113 }),
+					);
+		});
+		const supervisor = createLaunchctlVoiceSupervisor(
+			501,
+			run,
+			clockOptions({ startAttempts: 2 }),
+		);
+
+		expect(await supervisor.start()).toBe("requested_but_down");
+	});
+});
