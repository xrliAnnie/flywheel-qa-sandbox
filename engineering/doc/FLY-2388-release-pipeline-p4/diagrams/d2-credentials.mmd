flowchart TB
  subgraph GH["GitHub 仓库 xrliAnnie/flywheel(私有)"]
    subgraph REL["environment: release(只有 main 分支上的 job 能读)"]
      CF["CLOUDFLARE_API_TOKEN<br/>(Annie 一次性放入)"]
      CR["FW_CUSTOMER_RELEASE_TOKEN<br/>(runner 一次性 mint,零回显)"]
      OIDC["OIDC id-token<br/>(无长期 npm token)"]
    end
    BETA["FW_BETA_PUBLISH_TOKEN<br/>(repo secret,不变)"]
  end
  WB["payload-beta-release.yml<br/>每 6h 发 beta"] --> BETA
  WP["payload-promote.yml<br/>prepare"] --> BETA
  WC["payload-promote-commit.yml(新)<br/>commit / abandon / withdraw"] --> CR
  WA["payload-activation.yml<br/>infra:灌 sha · publish:发薄壳"] --> CF
  WA --> OIDC
  WA -.->|只算 sha256| CR
  WK["Cloudflare Worker<br/>只存三把 token 的 sha256"]
  BETA --> WK
  CR --> WK
  CF -->|wrangler secret put| WK
  OIDC --> NPM["公共 npm<br/>@flywheel-ai/onboard"]
  classDef env fill:#fff8ec,stroke:#ff9500,color:#1d1d1f
  classDef new fill:#e8f1ff,stroke:#007aff,color:#1d1d1f
  class CF,CR,OIDC env
  class WC new
