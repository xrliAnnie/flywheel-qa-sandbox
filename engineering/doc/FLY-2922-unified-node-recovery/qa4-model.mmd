erDiagram
  ACTOR_BINDING ||--|| PRODUCTION_HEAD : authorizes
  ACTOR_BINDING ||--|| ROOM_CAMPAIGN : authorizes
  PRODUCTION_HEAD ||--|| CODE_REVIEW : binds
  PRODUCTION_HEAD ||--|| CI_RUN : binds
  PRODUCTION_HEAD ||--|| SOURCE_CLONE : supplies_bytes
  QA_FIXTURE ||--|| SOURCE_CLONE : constrains_issue
  SOURCE_CLONE ||--|| ROOM_CAMPAIGN : launches
  ROOM_CAMPAIGN ||--|| SANDBOX_RUN : contains
  SANDBOX_RUN ||--o{ EXECUTION : advances
  EXECUTION ||--o{ DISPATCH_LEDGER : materializes
  SANDBOX_RUN ||--o{ DRIVER_STEP : observes
  ROOM_CAMPAIGN ||--|| EVIDENCE_BUNDLE : snapshots
  ROOM_CAMPAIGN ||--|| PRODUCTION_GUARD : monitors
  EVIDENCE_BUNDLE ||--|| OUTER_QA_VERDICT : supports
  ROOM_CAMPAIGN ||--|| TEARDOWN_RECEIPT : closes

  ACTOR_BINDING {
    string execution_id PK
    string project_name
    string session_role
    string worktree_path
  }
  PRODUCTION_HEAD {
    string sha40 PK
    string production_repo
    string pr_number
  }
  CODE_REVIEW {
    string question_id
    string verdict
    string sha40
  }
  CI_RUN {
    string run_id
    string conclusion
    string sha40
  }
  QA_FIXTURE {
    string issue_id PK
    string description_digest
    string sandbox_repo
  }
  SOURCE_CLONE {
    string path
    string detached_sha
    string origin_sandbox
    string production_push_disabled
  }
  ROOM_CAMPAIGN {
    int primary_slot
    int secondary_slot
    string owner_claim
  }
  SANDBOX_RUN {
    string run_id PK
    string status
    string fixture_issue
  }
  EXECUTION {
    string execution_id PK
    string node
    int attempt
    int launch_ordinal
  }
  DISPATCH_LEDGER {
    string ledger_id PK
    string state
    string receipt
  }
  DRIVER_STEP {
    int step
    string result
  }
  EVIDENCE_BUNDLE {
    string snapshot_path
    string digest
  }
  PRODUCTION_GUARD {
    string before_digest
    string after_digest
    string room_worktree_scan
  }
  OUTER_QA_VERDICT {
    string authority
    string verdict
  }
  TEARDOWN_RECEIPT {
    string owner
    string state
  }
