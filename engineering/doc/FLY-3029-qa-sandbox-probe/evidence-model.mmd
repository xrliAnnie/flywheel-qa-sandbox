classDiagram
    class RepositoryChange {
      target README.md
      literal exactly once
      diff one added line
    }
    class GitEvidence {
      probe commit SHA
      upstream contains probe SHA
      branch README diff
    }
    class PhaseIdentity {
      current FLYWHEEL_EXEC_ID
      own inbox only
    }
    class ProgressCursor {
      commit complete
      push complete
      next unfinished step
    }
    class DriverReceipt {
      dead runner replaced
      live runner preserved
      same thread resumed
      submission returned
    }
    class Verdict {
      repository change proven
      lifecycle proven separately
    }
    RepositoryChange --> GitEvidence : commit and push
    PhaseIdentity --> ProgressCursor : writes own cursor
    ProgressCursor --> GitEvidence : survives body swap
    GitEvidence --> DriverReceipt : handoff emits evidence
    DriverReceipt --> Verdict : authoritative QA signal
