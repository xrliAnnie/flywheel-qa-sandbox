{
 "mcpServers": {
  "linear-api": {
   "type": "http",
   "url": "https://mcp.linear.app/mcp",
   "headers": {
    "Authorization": "<REDACTED>"
   }
  },
  "xiaohongshu-mcp": {
   "type": "http",
   "url": "http://127.0.0.1:18060/mcp"
  },
  "context7": {
   "type": "http",
   "url": "https://mcp.context7.com/mcp",
   "headers": {
    "Authorization": "${CONTEXT7_API_KEY:-}"
   }
  },
  "playwright": {
   "command": "npx",
   "args": [
    "@playwright/mcp@latest"
   ]
  }
 }
}