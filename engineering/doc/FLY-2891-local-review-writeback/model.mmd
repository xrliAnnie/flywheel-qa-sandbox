        text observed_effort "真实思考档位"
        text required_model "路由要求的模型"
        int model_match "对上了吗"
    }
    REVIEW_GATE_ACCEPTANCE {
        text codex_turn_id PK "被接受的那个回合"
        int final_round "它在线程内是第几轮"
        int rounds_total "总共几轮（用来对账）"
        text observed_model "门核实过的真实模型"
    }
    CODEX_REVIEW_JOB {
        text request_id PK "Astra 线已有：每轮一行"
        text reviewer_verdict "原始结论"
        text completed_at "新增：评完时间"
