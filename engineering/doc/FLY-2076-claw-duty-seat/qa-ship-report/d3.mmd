  R --> P4["founder 必达动作"]
  P1 --> Z["改完立刻生效<br/><b>不用重启任何进程</b>"]
  P2 --> Z
  P3 --> Z
  P4 --> Z
  style DB fill:#f2e8ff,stroke:#af52de,stroke-width:2px
  style Z fill:#e8f9ee,stroke:#34c759,stroke-width:2px
