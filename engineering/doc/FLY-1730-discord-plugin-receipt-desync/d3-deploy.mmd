flowchart TB
    subgraph H["先上锁(HOLD)"]
        H1["冻结 FLY-1676 管线切换<br/>+ FLY-1645 环境变量清理"]
    end
    subgraph PA["Phase A — 检查器先行"]
        A1["主仓 PR:完整性检查器<br/>同时认新旧两个标志"] --> A2["部署 + 显式收敛到<br/>生产脚本目录"]
    end
    subgraph PB["Phase B — 插件部署"]
        B1["记录部署前进程清单<br/>(含寄生进程)"] --> B2["fork PR 合入<br/>(版本号现算 +1)"]
