        B5 --> B6["归档遗留待重试文件"]
    end
    subgraph PC["Phase C — 验收后解锁"]
        C1["真机验收:founder 频道两条消息<br/>15 分钟零告警"] --> C2["释放两条 HOLD"]
    end
    H --> PA --> PB --> PC
    style H fill:#f3e8fd,stroke:#af52de
