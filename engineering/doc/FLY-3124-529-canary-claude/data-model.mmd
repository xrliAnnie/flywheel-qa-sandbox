classDiagram
    class Execution {
      +execId: UUID
      +vendor: codex or claude-code
      +phase: design or downstream
    }
    class TurnReceipt {
      +result: yours or not-yours
      +epoch: integer
      +activation: stable identity
    }
    class NativeInstruction {
      +instructionId: UUID
      +recipientExecId: UUID
      +rawBody: exact text
    }
    class CommDbSnapshot {
      +source: managed read-only copy
      +fromAgent: Lead identity
      +type: instruction
    }
    class MarkerLine {
      +bytes: printable ASCII
      +length: 1..512
      +count: exactly one
    }
    class ProbeCommit {
      +path: probe.txt only
      +sha: local immutable commit
      +pushed: false
    }
    class CompletionReceipt {
      +instructionId: UUID
      +rawBodySha256: hex
      +probeCommitSha: hex
      +state: completed
    }
    class TerminalRoute {
      +empty: no_code if allowed
      +committed: Lead close or cancel
    }
    class DesignEvidence {
      +docs: exploration research plan
      +reviewVerdict: APPROVED
      +hostedReport: URL
    }
    Execution "1" --> "1" TurnReceipt : must own write turn
    Execution "1" --> "0..1" NativeInstruction : must be recipient
    NativeInstruction "1" --> "1" CommDbSnapshot : verify provenance
    NativeInstruction "1" --> "1..*" MarkerLine : exact extraction
    MarkerLine "1..*" --> "0..1" ProbeCommit : conditional append
    ProbeCommit "1" --> "1" CompletionReceipt : durable idempotency
    CompletionReceipt "1" --> "1" TerminalRoute : explicit closure
    Execution "1" --> "1" DesignEvidence : design output
