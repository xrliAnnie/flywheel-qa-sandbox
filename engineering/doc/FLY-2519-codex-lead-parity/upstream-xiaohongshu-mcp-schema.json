          "scroll_speed": {
            "type": "string",
            "description": "【仅当load_all_comments为true时生效】滚动速度slow慢速、normal正常、fast快速"
          },
          "xsec_token": {
            "type": "string",
            "description": "访问令牌，从Feed列表的xsecToken字段获取"
          }
        },
        "required": [
          "feed_id",
          "xsec_token"
        ],
