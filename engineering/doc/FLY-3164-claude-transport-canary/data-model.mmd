classDiagram
    direction LR
    class Execution {
        exec_id : uuid
        activation_id : string
        node : eng_design 或 implement 或 qa
        backend : claude-code 或 codex
    }
    class TurnReceipt {
        answer : yours 或 not-yours 或 no-turn
        phase : string
        epoch : int
        说明「谁可以写」
    }
    class LeadInstruction {
        id : uuid
        type : instruction
        from_agent : Lead id
        to_agent : writer exec_id
        content : 原始字节
        content_ref : 必须为空
        location : live 或 archived
        说明「写什么」
    }
    class DeliveryReceipt {
        message_id : uuid
        location : live 或 archived
        state : LEASED 或 ACKED
        delivered_at : 时间戳
    }
    class SourceBuffer {
        path : 私有临时目录 source.bin
        sha256 : hex
    }
    class Marker {
        bytes : 1-512 可打印 ASCII
        无首尾空格
    }
    class ProbeCommit {
        sha : git sha
        paths : 只有 probe.txt
        pushed : false
        state : fresh 或 补提交 或 already_present
    }
    class WriterReceipt {
        instruction_id : uuid
        writer_exec : uuid
        source_sha256 : hex
        commit_sha : git sha
    }
    class QaAudit {
        verdict : pass 或 fail 或 unverifiable
        只读，不授予写权限
    }
    Execution "1" --> "1" TurnReceipt : 写前查询
    Execution "1" <-- "0..*" LeadInstruction : to_agent 绑定
    LeadInstruction "1" --> "1" DeliveryReceipt : message-status
    LeadInstruction "1" --> "1" SourceBuffer : 只读复制 content
    SourceBuffer "1" --> "0..*" Marker : 严格格式解析
    Marker "1..*" --> "0..1" ProbeCommit : 按 Git 状态追加或复用
    ProbeCommit "1" --> "1" WriterReceipt : ask --report
    WriterReceipt "1" --> "1" QaAudit : 预期身份
    LeadInstruction "1" --> "1" QaAudit : live 或归档快照核对
