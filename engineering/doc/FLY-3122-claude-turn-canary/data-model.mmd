classDiagram
    class CurrentExecution {
      +execId: UUID
      +vendor: codex or claude-code
      +phase: design or implement or qa
    }
    class TurnReceipt {
      +result: yours or not-yours
      +epoch: integer
      +activation: stable identity
    }
    class NativeInstruction {
      +instructionId: UUID
      +recipientExecId: UUID
      +rawBody: exact delivered text
      +carrier: native turn input
    }
    class MarkerExtraction {
      +grammar: canonical or fenced text
      +markerLines: exact raw strings
      +ambiguous: false
    }
    class ProgressReceipt {
      +instructionId: UUID
      +status: received or done
      +rawBody: persisted before mutation
      +probeSha: optional
    }
    class ProbeFile {
      +path: probe.txt
      +rule: append-only
      +lineCount: exactly one per marker
    }
    class ProbeCommit {
      +sha: immutable local commit
      +changedPath: probe.txt only
      +pushed: false
    }
    class DesignEvidence {
      +docs: exploration research plan
      +reviewVerdict: APPROVED
      +hostedReport: URL
    }
    class WorkflowClose {
      +owner: Lead
      +action: close or cancel
      +pullRequest: none
    }
    CurrentExecution "1" --> "1" TurnReceipt : must own write turn
    CurrentExecution "1" --> "0..1" NativeInstruction : must be native recipient
    NativeInstruction "1" --> "1" ProgressReceipt : persist before mutation
    NativeInstruction "1" --> "0..1" MarkerExtraction : parse one grammar
    MarkerExtraction "1" --> "0..1" ProbeFile : authorizes exact lines
    ProbeFile "1" --> "0..1" ProbeCommit : local commit or verified no-op
    ProbeCommit "0..1" --> "1" ProgressReceipt : records actual SHA
    ProgressReceipt "1" --> "1" WorkflowClose : report then park
    CurrentExecution "1" --> "1" DesignEvidence : design phase output
