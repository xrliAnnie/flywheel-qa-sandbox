classDiagram
    class CurrentExecution {
      +execId: runtime env
      +vendor: codex
      +phase: eng_design
    }
    class TurnReceipt {
      +result: yours
      +epoch: 1
      +activation: server-issued
    }
    class DesignEvidence {
      +docsCommit: git head
      +reviewVerdict: approved
      +hostedReport: url
    }
    class LeadInstruction {
      +instructionId: exact id
      +toExecution: implement exec
      +markerLine: exact delivered text
    }
    class ScopeResolution {
      +noPr: true
      +noShip: true
      +noDeploy: true
    }
    class ProbeFile {
      +path: probe.txt
      +line: LeadInstruction.markerLine
    }
    class LocalCommit {
      +changedPath: probe.txt
      +push: forbidden
    }
    CurrentExecution "1" --> "1" TurnReceipt : requests own TURN
    TurnReceipt "1" --> "1" DesignEvidence : authorizes design writes
    LeadInstruction "0..1" --> "0..1" ProbeFile : supplies only valid line
    ScopeResolution "1" --> "0..1" ProbeFile : permits bounded implement
    ProbeFile "0..1" --> "0..1" LocalCommit : committed locally
