flowchart TD
    A0["A 段(切换窗口之前,不停机)<br/>建工具 + 隔离预演 + PR 评审 + QA"] --> W["等 Annie 拍板切换窗口时刻"]
    W --> S1["① 预演<br/>在隔离副本上把整套切换完整跑通<br/>(和真跑同一套代码,只是路径不同)"]
    S1 --> S2["② 冻结<br/>不再接新活;清点两个旧信箱的未读;<br/>建好新库底座;Codex Lead 流水账清零"]
    S2 --> S3["③ 停全部旧写手<br/>Bridge / Lead / Runner / 定时任务全停<br/>四重验证:进程、tmux、cmux、文件句柄"]
    S3 --> S4["④ 一致快照<br/>所有旧数据完整备份(含 WAL 日志)"]
    S4 --> S5["⑤ 迁移<br/>未读消息按统一身份对账搬进新库,<br/>账目双向核对,一条不多一条不少"]
    S5 --> S6["⑥ 安全重置<br/>旧库归档改只读;原路径放墓碑<br/>(旧程序若复活,写入立刻报错)"]
    S6 --> S7["⑦ epoch 围栏<br/>新库拒绝一切旧时代的写入"]
    S7 --> LF["实弹测试<br/>真的启动一次旧程序,<br/>亲眼确认它被挡住"]
    LF --> GNG["Go/No-Go 检查<br/>十条硬标准逐条机器判定"]
    GNG --> D1{"Annie 决策一<br/>允许预启动?"}
    D1 -->|"是"| S8a["⑧a 预启动(保险栓不拔)<br/>新引擎起来但不对外做任何事"]
    S8a --> EV["补最后一条证据:<br/>旧钥匙打新门,确认被拒"]
    EV --> D2{"Annie 决策二<br/>最终 GO?"}
    D2 -->|"GO"| S8b["⑧b 上电<br/>拔保险栓,Lead 回归,新引擎接管"]
    S8b --> ACC["上线验收<br/>真 issue 全链路 + Lead 重启探针 +<br/>呼叫 Annie 探针 + 旧路径零新写入"]
    D1 -->|"否"| RB["⑨ 回滚点<br/>按备份原路退回旧系统"]
    D2 -->|"NO-GO"| RB
    ACC -->|"验收失败"| FR["停新入口,按预案修复"]
    ACC -->|"全绿"| DONE["v2 正式运行"]
