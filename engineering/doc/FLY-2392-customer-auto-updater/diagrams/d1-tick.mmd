flowchart TD
  T["定时器 com.flywheel.auto-update<br/>默认 03:00 / 09:00 / 15:00 / 21:00"] --> W["启动脚本<br/>已关闭? 找不到 node? 找不到更新程序副本?<br/>任一成立: 静默退出"]
  W --> L{"拿到内核独占锁?"}
  L -- "另一个更新在跑" --> X["记一行日志, 退出"]
  L -- "拿到" --> LG{"本地账本可读?"}
  LG -- "损坏" --> XC["报「记录损坏, 请联系我们」<br/>不联网, 不改任何东西"]
  LG -- "正常" --> ST["结算上次未完成的更新<br/>(见数据模型卡)"]
  ST --> M["向发布服务器查最新版本"]
  M -- "服务器说: 暂停发布" --> P["本机保持原版本, 退出"]
  M -- "最新 == 当前" --> U["已是最新, 退出"]
  M -- "最新版在本机黑名单里" --> H["跳过, 退出"]
  M -- "当前版本已被发布方撤回" --> I["记入黑名单, 立刻换回可用版本"]
  M -- "有新版但不在安装时窗" --> D["记下待装版本, 下次再来"]
  M -- "有新版且在时窗内" --> A["下载 / 校验 / 装进新目录"]
  I --> A2["切换指针 / 重启 / 90 秒健康检查"]
  A --> A2
  A2 -- "通过" --> OK["记为可用版本, 清理旧目录"]
  A2 -- "失败" --> RB["先记黑名单, 再切回上一个可用版本并重启"]
