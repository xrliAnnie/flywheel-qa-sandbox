  refill_issue ||--o{ refill_relation : "挡住 / 被挡"
  refill_slot ||--o{ refill_eval_intent : "释放时写"
  refill_eval_intent ||--|| refill_decision : "每条都有结论"
  refill_decision ||--o{ refill_suggestion : "选中"
