# EXAMPLE sanitized env — key names only, ZERO values.
# A real capture produces this from ~/.flywheel/.env via redact_env_to_keys.
# On the new host Annie fills the real values (provisioning never touches them).

# Per-lead Discord bot tokens (names referenced by projects.json botTokenEnv).
EXAMPLE_COS_BOT_TOKEN=
EXAMPLE_ENG_BOT_TOKEN=
EXAMPLE_PRODUCT_BOT_TOKEN=

# Bridge / orchestrator.
TEAMLEAD_INGEST_TOKEN=
LINEAR_API_KEY=

# Non-secret runtime config (kept for completeness; not token-gated).
TEAMLEAD_PORT=
FLYWHEEL_BRIDGE_URL=
