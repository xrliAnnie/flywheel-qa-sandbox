#!/usr/bin/env bash
# FLY-2003: long-lived runner daemons use exactly the account already selected
# in their execution-scoped CODEX_HOME. Automatic account switching is retired.
#
# FLY-1887 DO-NOT-TIMEOUT: one-shot deadlines belong to the separately
# installed global wrapper; the resident app-server is a direct passthrough.
set -uo pipefail

exec codex "$@"
