#!/usr/bin/env bash
# FLY-123 WS-B (P1 = 4-C): repo-owned, CODEX_HOME-aware fork of Annie's global
# `codex-with-fallback`. Selected ONLY for Flywheel Codex runners via
# FLYWHEEL_CODEX_BIN (codex-resume.ts) — Annie's global wrapper is untouched.
#
# Forked faithfully (same 429 / auth-expiry / model-not-supported detection),
# changed only to be per-runner:
#   - the seed pool is the SHARED FLYWHEEL_CODEX_PROFILES_DIR (default global);
#   - rotation goes through the sibling `flywheel-codex-profile`, which writes
#     ONLY this runner's $CODEX_HOME (per-home auth.json + .active);
#   - codex itself runs against $CODEX_HOME (it honors it natively).
# Net: each runner rotates its own account state on rate-limit; concurrent
# runners never clobber each other's auth.json.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROFILE_BIN="$SCRIPT_DIR/flywheel-codex-profile"
POOL_DIR="${FLYWHEEL_CODEX_PROFILES_DIR:-$HOME/.codex/profiles}"

# FLY-696 M1/④: surface a Codex per-runner rotation in the unified Alerts channel
# (today it is silent). Best-effort — the runner injects FLYWHEEL_COMM_CLI +
# FLYWHEEL_BRIDGE_URL; when either is absent the notify is a no-op and NEVER blocks
# the rotation. Credentials are not involved (only from/to profile NAMES).
active_profile() {
  "$PROFILE_BIN" status 2>/dev/null | head -1 | sed 's/Active profile: //'
}
notify_rotation() {
  local from="$1" to="$2" reason="$3"
  [[ -n "${FLYWHEEL_COMM_CLI:-}" && -n "$to" ]] || return 0
  local args=(account-rotation-notify --provider codex --to "$to" --reason "$reason")
  [[ -n "$from" ]] && args+=(--from "$from")
  # Codex R1 HIGH-1: fire-and-forget in a background subshell — a hung Bridge
  # must NEVER wedge the rotation retry loop (the CLI also hard-bounds the POST
  # at 5s as a second layer). `|| true` alone only swallows the exit code, not
  # a hang.
  ( node "$FLYWHEEL_COMM_CLI" "${args[@]}" >/dev/null 2>&1 || true ) &
}
# Rotate to the next pool profile, then emit the Alerts notice (from→to).
rotate_and_notify() {
  local reason="$1" before after
  before="$(active_profile)"
  "$PROFILE_BIN" next >&2
  after="$(active_profile)"
  notify_rotation "$before" "$after" "$reason"
}

num_profiles=$(ls -d "$POOL_DIR"/*/ 2>/dev/null | wc -l | tr -d ' ')
[[ "$num_profiles" -eq 0 ]] && num_profiles=1

start_profile=$("$PROFILE_BIN" status 2>/dev/null | head -1 | sed 's/Active profile: //')
attempts=0
max_attempts=$num_profiles

while [[ $attempts -lt $max_attempts ]]; do
  tmpfile=$(mktemp)
  codex "$@" > >(tee "$tmpfile") 2> >(tee -a "$tmpfile" >&2)
  exit_code=${PIPESTATUS[0]}

  if [[ $exit_code -eq 0 ]]; then
    rm -f "$tmpfile"
    exit 0
  fi

  output=$(cat "$tmpfile")
  rm -f "$tmpfile"

  if echo "$output" | grep -qiE 'not supported when using Codex'; then
    attempts=$((attempts + 1))
    if [[ $attempts -lt $max_attempts ]]; then
      echo "[flywheel-codex-with-fallback] Model not supported (attempt $attempts/$max_attempts). Switching profile..." >&2
      rotate_and_notify model_unsupported
    else
      echo "[flywheel-codex-with-fallback] Model not supported on any profile. Falling back to gpt-5.5..." >&2
      "$PROFILE_BIN" use "$start_profile" >&2
      new_args=()
      skip_next=false
      for arg in "$@"; do
        if $skip_next; then skip_next=false; continue; fi
        if [[ "$arg" == "-m" || "$arg" == "--model" ]]; then skip_next=true; continue; fi
        if [[ "$arg" == -m=* || "$arg" == --model=* ]]; then continue; fi
        new_args+=("$arg")
      done
      exec codex -m gpt-5.5 "${new_args[@]}"
    fi
  elif echo "$output" | grep -qiE 'refresh_token_reused|token_expired|Please try signing in again|Please log out and sign in again'; then
    attempts=$((attempts + 1))
    if [[ $attempts -lt $max_attempts ]]; then
      echo "[flywheel-codex-with-fallback] Auth token expired (attempt $attempts/$max_attempts). Switching profile..." >&2
      rotate_and_notify auth_expired
    else
      echo "[flywheel-codex-with-fallback] AUTH_EXPIRED: all $max_attempts profiles have expired tokens. Run /codex-relogin." >&2
      "$PROFILE_BIN" use "$start_profile" >&2
      exit "$exit_code"
    fi
  elif echo "$output" | grep -qiE '429|rate.?limit|too many requests|capacity|usage.?limit'; then
    attempts=$((attempts + 1))
    if [[ $attempts -lt $max_attempts ]]; then
      echo "[flywheel-codex-with-fallback] Rate limit (attempt $attempts/$max_attempts). Switching profile..." >&2
      rotate_and_notify rate_limit
    else
      echo "[flywheel-codex-with-fallback] All $max_attempts profiles exhausted. Giving up." >&2
      exit "$exit_code"
    fi
  else
    # Non-retryable error.
    exit "$exit_code"
  fi
done

exit "${exit_code:-1}"
