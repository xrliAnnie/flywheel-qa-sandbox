#!/usr/bin/env bash
# Runner-private launcher: CODEX_HOME is intentional here. The separately
# installed global shim pins all roots and does not inherit ambient runner env.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_BIN="${FLYWHEEL_NODE_BIN:-node}"

if [[ "$NODE_BIN" == */* ]]; then
  if [[ ! -x "$NODE_BIN" ]]; then
    echo "Error: FLYWHEEL_NODE_BIN is not executable: $NODE_BIN" >&2
    exit 127
  fi
elif ! command -v "$NODE_BIN" >/dev/null 2>&1; then
  echo "Error: Node executable '$NODE_BIN' was not found" >&2
  exit 127
fi

CODEX_DIR="${CODEX_HOME:-$HOME/.codex}"
PROFILES_DIR="${FLYWHEEL_CODEX_PROFILES_DIR:-$HOME/.codex/profiles}"
LEDGER_ROOT="${FLYWHEEL_STATE_DIR:-$HOME/.flywheel}/codex-account-ledger"
REGISTRY_PATH="$SCRIPT_DIR/../agents/codex-account-registry.json"

exec "$NODE_BIN" "$SCRIPT_DIR/flywheel-codex-profile.mjs" \
  --home "$CODEX_DIR" \
  --profiles "$PROFILES_DIR" \
  --ledger-root "$LEDGER_ROOT" \
  --registry "$REGISTRY_PATH" \
  "$@"
