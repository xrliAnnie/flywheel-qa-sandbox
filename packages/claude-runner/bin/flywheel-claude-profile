#!/usr/bin/env bash
# FLY-696 M1/⑤ (C1): machine-level Claude account rotation over the macOS
# Keychain — the switch executor's `applyProfile`/`readActiveProfile` backend.
#
# Model (plan §3.1 Approach A pool-rotation, write path = "security -i"):
#   - The pool ($FLYWHEEL_CLAUDE_PROFILES_DIR, default ~/.flywheel/claude-profiles)
#     holds one 0600 .credentials.json per account (0700 dir, symlinks refused).
#   - `use <name>` swaps the machine Keychain item "Claude Code-credentials"
#     to that account. New claude spawns read the new account; live sessions
#     keep their in-memory token and wait for reset (D1 — never hot-swapped).
#
# RED LINES (verified on-machine, spike 2026-07-03):
#   - NO CREDENTIAL EVER ENTERS ANY argv. `security add-generic-password -w <v>`
#     puts the token in argv (ps-visible) and the interactive/stdin `-w` prompt
#     truncates at 128 bytes (readpassphrase). The safe path is `security -i`:
#     the whole command (value included) travels on STDIN of /usr/bin/security
#     — ps shows only "security -i". 1950-byte JSON with embedded quotes and a
#     spacey quoted service name round-trip EXACTLY. The value is passed to the
#     bash-builtin printf (no external argv) and MUST be a single token: we
#     fail closed unless it is whitespace-free compact JSON starting with "{".
#   - NEVER BREAK THE CLAUDE LOGIN. verify-before-commit: after writing we read
#     the item back and require an exact match before touching `.active`; on a
#     mismatch we roll back to the captured previous value and exit non-zero.
#     `/usr/bin/security` needs no per-item provisioning (its Apple-signed
#     identity passes the item ACL/partition — all existing Claude items are
#     security-tool-owned), so a claude re-login recreating the item never
#     strands us (unlike a partition-list/trusted-app provision, which is lost
#     on recreation — verified).
#   - Same interprocess lock as the Node switch executor (withMkdirLock —
#     mkdir + unique holder token, dead-PID stale-break, unlink+rmdir release) on
#     $FLYWHEEL_CLAUDE_ACCOUNTS_LOCK so bash and Node never interleave.
#
# Env overrides (tests inject a fake security bin; real-machine QA points at a
# scratch keychain + dummy service so the real login item is NEVER touched):
#   FLYWHEEL_CLAUDE_PROFILES_DIR      pool dir       (~/.flywheel/claude-profiles)
#   FLYWHEEL_CLAUDE_ACCOUNTS_LOCK     lock dir       (~/.flywheel/claude-accounts.lock)
#   FLYWHEEL_CLAUDE_SECURITY_BIN      security tool  (/usr/bin/security)
#   FLYWHEEL_CLAUDE_KEYCHAIN_SERVICE  item service   (Claude Code-credentials)
#   FLYWHEEL_CLAUDE_KEYCHAIN_ACCOUNT  item account   ($USER)
#   FLYWHEEL_CLAUDE_KEYCHAIN          keychain path  (empty = default search list)
#   FLYWHEEL_CLAUDE_LOCK_TIMEOUT_MS   lock timeout   (30000)
#   FLYWHEEL_CLAUDE_PS_BIN            process probe  (/bin/ps; tests may override)
set -euo pipefail

COMMAND="${1:-}"
TRAMPOLINE_NODE="${FLYWHEEL_NODE_BIN:-node}"
# A manual mutation must own a dedicated process group. macOS exposes setsid(2)
# but no setsid executable, so a tiny Node trampoline creates the group and
# forwards terminal cancellation to the whole mutation tree. The automatic
# adapter already starts this script detached and sets delegated-lock metadata.
case "$COMMAND" in
  use|next|capture)
    if [[ -z "${FLYWHEEL_CLAUDE_LOCK_DELEGATED:-}" && "${FLYWHEEL_PROFILE_GROUP_LEADER:-}" != "1" ]]; then
      export FLYWHEEL_PROFILE_GROUP_LEADER=1
      exec "$TRAMPOLINE_NODE" --input-type=module -e '
        import { spawn } from "node:child_process";
        const [file, ...args] = process.argv.slice(1);
        const child = spawn(file, args, { detached: true, stdio: "inherit", env: { ...process.env, FLYWHEEL_NODE_BIN: process.execPath } });
        const forward = (signal) => { if (child.pid) { try { process.kill(-child.pid, signal); } catch {} } };
        process.on("SIGINT", () => forward("SIGINT"));
        process.on("SIGTERM", () => forward("SIGTERM"));
        child.once("error", (error) => { process.stderr.write(`${error.message}\n`); process.exit(1); });
        child.once("exit", (code, signal) => {
          if (typeof code === "number") process.exit(code);
          process.stderr.write(`flywheel-claude-profile terminated by ${signal ?? "unknown signal"}\n`);
          process.exit(1);
        });
      ' "${BASH_SOURCE[0]}" "$@"
    fi
    ;;
esac

POOL_DIR="${FLYWHEEL_CLAUDE_PROFILES_DIR:-$HOME/.flywheel/claude-profiles}"
LOCK_DIR="${FLYWHEEL_CLAUDE_ACCOUNTS_LOCK:-$HOME/.flywheel/claude-accounts.lock}"
SEC_BIN="${FLYWHEEL_CLAUDE_SECURITY_BIN:-/usr/bin/security}"
SERVICE="${FLYWHEEL_CLAUDE_KEYCHAIN_SERVICE:-Claude Code-credentials}"
ACCT="${FLYWHEEL_CLAUDE_KEYCHAIN_ACCOUNT:-$USER}"
KEYCHAIN="${FLYWHEEL_CLAUDE_KEYCHAIN:-}"
LOCK_TIMEOUT_MS="${FLYWHEEL_CLAUDE_LOCK_TIMEOUT_MS:-30000}"
PS_BIN="${FLYWHEEL_CLAUDE_PS_BIN:-/bin/ps}"
ACTIVE_FILE="$POOL_DIR/.active"
ACCOUNTS_STORE="${FLYWHEEL_CLAUDE_ACCOUNTS_PATH:-$HOME/.flywheel/claude-accounts.json}"
TRANSITION_JOURNAL="${FLYWHEEL_CLAUDE_TRANSITION_JOURNAL:-$HOME/.flywheel/claude-account-transition.json}"
NODE_BIN="${FLYWHEEL_NODE_BIN:-node}"

# FLY-865: display-identity sync. `use` writes the target account's oauthAccount
# block into ~/.claude.json (the source `/status` reads email/org from) so a new
# claude shows the switched account; `capture` snapshots that identity beside the
# pooled token. CLAUDE_JSON_LOCK defaults to "${CLAUDE_JSON}.lock" so the real
# file maps to ~/.claude.json.lock — the SAME mkdir mutex scripts/inject-linear-
# issue.sh and scripts/test-teardown.sh serialize their trust-entry writes with,
# so the three read-merge-write writers never drop each other's changes. Scratch
# fixtures (FLYWHEEL_CLAUDE_JSON) get their own isolated lock.
CLAUDE_JSON="${FLYWHEEL_CLAUDE_JSON:-$HOME/.claude.json}"
CLAUDE_JSON_LOCK="${FLYWHEEL_CLAUDE_JSON_LOCK:-${CLAUDE_JSON}.lock}"
: "${CLAUDE_LOCK_STALE_S:=60}"   # steal a claude-json lock older than this (crash)
: "${CLAUDE_LOCK_WAIT_S:=30}"    # give up acquiring the claude-json lock after this

usage() {
  cat <<EOF
Usage: flywheel-claude-profile <command> [args]

Machine-level Claude account rotation (FLY-696). Swaps the shared Keychain
credential item; new claude processes pick up the new account, live sessions
wait for their reset (never hot-swapped).

Commands:
  list            Show pool profiles, mark the active one with *
  status          Show the active profile
  use <name>      Swap the machine Keychain to pool profile <name>
  next            Rotate to the next pool profile (sorted round-robin)
  capture <name>  Save the CURRENT Keychain credential into pool/<name>/
EOF
  exit 1
}

fail() { echo "Error: $*" >&2; exit 1; }
# FLY-871 R1/C3: exit with a SPECIFIC code (30 target-stale / 31 freshness-helper
# unavailable) so the Node switch executor can distinguish freshness failures
# from other failures and drive the candidate loop / fail-closed accordingly.
fail_code() { local code="$1"; shift; echo "Error: $*" >&2; exit "$code"; }

# Cross-platform stat (BSD/macOS `-f`, GNU/Linux `-c`) — CI runs Linux.
# GNU treats `-f` as FILESYSTEM stat and exits 0 with junk for unknown
# directives, so exit-code fallback is not enough: accept the BSD output only
# when it is purely numeric, else retry with GNU `-c`.
stat_num() { # $1 = bsd format, $2 = gnu format, $3 = path
  local v
  v=$(stat -f "$1" "$3" 2>/dev/null)
  case "$v" in
    ""|*[!0-9]*) v=$(stat -c "$2" "$3" 2>/dev/null) || return 1 ;;
  esac
  [[ -n "$v" ]] || return 1
  printf '%s' "$v"
}
stat_perms() { stat_num %Lp %a "$1"; }
stat_mtime() { stat_num %m %Y "$1"; }
process_start_time() {
  "$PS_BIN" -o lstart= -p "$1" 2>/dev/null | sed 's/^ *//;s/ *$//' || true
}

# ---------------------------------------------------------------- lock (C5)
# Byte-compatible with packages/teamlead/src/account-heal/mkdir-lock.ts:
# atomic mkdir + UNIQUE holder.<pid>.<token> marker. Cooperative waiters never
# steal from a live pid; dead/malformed holders are removed by unlinking only
# the marker observed and then rmdir (never recursive deletion of a replacement).
now_ms() { echo $(( $(date +%s) * 1000 )); }

find_holder_marker() {
  local found="" candidate
  if [[ -f "$LOCK_DIR/holder" ]]; then found="$LOCK_DIR/holder"; fi # legacy
  for candidate in "$LOCK_DIR"/holder.*; do
    [[ -f "$candidate" ]] || continue
    [[ -z "$found" ]] || return 2 # ambiguous ownership → fail closed
    found="$candidate"
  done
  [[ -n "$found" ]] || return 1
  printf '%s' "$found"
}

lock_is_stale() {
  local holder="" pid="" expected_start="" live_start="" mtime="" rc=0
  holder=$(find_holder_marker 2>/dev/null) || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  if [[ -z "$holder" ]]; then
    local mtime
    mtime=$(stat_mtime "$LOCK_DIR") || return 0 # dir vanished → free
    [[ $(( $(date +%s) - mtime )) -gt 120 ]]
    return
  fi
  pid=$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$holder" 2>/dev/null || true)
  if [[ -n "$pid" ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      expected_start=$(sed -n 's/.*"processStartTime":"\([^"]*\)".*/\1/p' "$holder" 2>/dev/null || true)
      if [[ -n "$expected_start" ]]; then
        live_start=$(process_start_time "$pid")
        [[ -n "$live_start" && "$live_start" != "$expected_start" ]] && return 0
      fi
      return 1
    fi
    # Byte-compat with mkdir-lock.ts isProcessAlive: EPERM = the process
    # EXISTS (just not ours) → alive, NOT stale. Only ESRCH (no such
    # process) breaks the lock.
    local err
    err=$(kill -0 "$pid" 2>&1 || true)
    case "$err" in
      *[Nn]ot\ permitted*) return 1 ;; # alive (EPERM)
      *) return 0 ;;             # dead (ESRCH) → stale
    esac
  fi
  mtime=$(stat_mtime "$holder" 2>/dev/null || echo "")
  [[ -n "$mtime" && $(( $(date +%s) - mtime )) -gt 120 ]]
}

break_stale_lock() {
  local holder="" current="" claim="" rc=0
  holder=$(find_holder_marker 2>/dev/null) || rc=$?
  [[ "$rc" -eq 2 ]] && return 1
  lock_is_stale || return 1
  if [[ -n "$holder" ]]; then
    current=$(find_holder_marker 2>/dev/null || true)
    [[ "$current" == "$holder" ]] || return 1
    # Atomically claim the exact marker while it is still inside LOCK_DIR. Until
    # the claim is removed, rmdir cannot succeed and a successor directory cannot
    # be installed. This avoids relying on inode uniqueness (Linux may immediately
    # reuse a removed directory's inode).
    claim="$LOCK_DIR/.stale-break.$$.$RANDOM"
    mv "$holder" "$claim" 2>/dev/null || return 1
    rm -f "$claim" 2>/dev/null || return 1
  else
    # A breaker killed after the atomic marker rename can leave its unique claim
    # behind. Only reap regular files/symlinks in an already-proven-stale lock;
    # unknown entry types remain fail-closed and are bounded by the deadline.
    local orphan
    for orphan in "$LOCK_DIR"/.stale-break.*; do
      [[ -e "$orphan" || -L "$orphan" ]] || continue
      [[ -f "$orphan" || -L "$orphan" ]] || return 1
      rm -f -- "$orphan" 2>/dev/null || return 1
    done
  fi
  rmdir "$LOCK_DIR" 2>/dev/null
}

LOCK_HELD=0
DELEGATED_LOCK_ACCEPTED=0
LOCK_MARKER=""
LOCK_TOKEN=""

make_lease_proof() { # <marker> <token>
  "$NODE_BIN" -e 'process.stdout.write(JSON.stringify({lockPath:process.argv[1],markerPath:process.argv[2],ownershipToken:process.argv[3]}))' \
    "$LOCK_DIR" "$1" "$2"
}

validate_lease_proof() {
  [[ -n "${FLYWHEEL_LEASE_PROOF:-}" ]] || return 1
  FLYWHEEL_LEASE_PROOF_VALUE="$FLYWHEEL_LEASE_PROOF" "$NODE_BIN" --input-type=module - <<'NODE'
import { readFileSync } from "node:fs";
import { basename, dirname } from "node:path";
let proof;
try { proof = JSON.parse(process.env.FLYWHEEL_LEASE_PROOF_VALUE ?? ""); }
catch { process.exit(1); }
if (!proof || typeof proof.lockPath !== "string" || typeof proof.markerPath !== "string" ||
    typeof proof.ownershipToken !== "string" || proof.ownershipToken.length === 0 ||
    dirname(proof.markerPath) !== proof.lockPath ||
    !(basename(proof.markerPath).startsWith("holder.") || basename(proof.markerPath) === "holder")) process.exit(1);
let marker;
try { marker = JSON.parse(readFileSync(proof.markerPath, "utf8")); }
catch { process.exit(1); }
if (proof.ownershipToken.startsWith("legacy-pid:")) {
  process.exit(String(marker?.pid) === proof.ownershipToken.slice("legacy-pid:".length) ? 0 : 1);
}
process.exit(marker?.token === proof.ownershipToken ? 0 : 1);
NODE
}

lease_fence_or_fail() {
  if ! validate_lease_proof; then
    echo "FLYWHEEL_LOCK_LEASE_LOST accounts lock ownership changed" >&2
    fail_code 39 "accounts lock lease/ownership lost — refusing shared mutation"
  fi
}

lock_holder_pid() {
  local holder
  holder=$(find_holder_marker) || return 1
  sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$holder" 2>/dev/null
}

# Never delete a lock that another process replaced after we acquired it.
release_lock() {
  if [[ "$LOCK_HELD" -eq 1 ]]; then
    local hpid="" token=""
    if [[ -n "$LOCK_MARKER" && -f "$LOCK_MARKER" ]]; then
      hpid=$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$LOCK_MARKER" 2>/dev/null || true)
      token=$(sed -n 's/.*"token":"\([^"]*\)".*/\1/p' "$LOCK_MARKER" 2>/dev/null || true)
    fi
    if [[ "$hpid" == "$$" && "$token" == "$LOCK_TOKEN" ]]; then
      # The unique path cannot name a replacement holder. rmdir succeeds only
      # while the directory is empty, so an established successor is fenced.
      rm -f "$LOCK_MARKER" 2>/dev/null || true
      rmdir "$LOCK_DIR" 2>/dev/null || true
    else
      echo "Warning: refusing to release $LOCK_DIR after lock ownership changed" >&2
    fi
    LOCK_HELD=0
    LOCK_MARKER=""
    LOCK_TOKEN=""
  fi
}

# Refresh an OWNED lease only. Delegated children deliberately leave the
# parent's marker untouched; the Node holder renews its own lease.
renew_lock() {
  [[ "$LOCK_HELD" -eq 1 ]] || return 0
  local hpid="" token=""
  [[ -n "$LOCK_MARKER" && -f "$LOCK_MARKER" ]] || return 1
  hpid=$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$LOCK_MARKER" 2>/dev/null || true)
  token=$(sed -n 's/.*"token":"\([^"]*\)".*/\1/p' "$LOCK_MARKER" 2>/dev/null || true)
  [[ "$hpid" == "$$" && "$token" == "$LOCK_TOKEN" ]] || return 1
  # touch -c never creates our unique marker inside a replacement directory.
  touch -c "$LOCK_MARKER" 2>/dev/null || return 1
  [[ -f "$LOCK_MARKER" ]] || return 1
}

renew_lock_or_fail() {
  if ! renew_lock || ! validate_lease_proof; then
    echo "FLYWHEEL_LOCK_LEASE_LOST accounts lock ownership changed" >&2
    fail_code 39 "accounts lock lease/ownership lost before commit — refusing switch"
  fi
}

# FLY-865: the ~/.claude.json lock (mkdir mutex + mtime stale-steal + timeout),
# byte-compatible with scripts/inject-linear-issue.sh:acquire_claude_lock so all
# three writers of ~/.claude.json serialize on the same lock. Only `use`'s
# identity write takes it (capture only reads — rename(2) is atomic, no torn
# read). Nesting order is always accounts-lock → claude-json-lock; inject/
# teardown take ONLY the claude-json lock, so there is no deadlock cycle.
CLAUDE_JSON_LOCK_HELD=0
release_claude_json_lock() {
  if [[ "$CLAUDE_JSON_LOCK_HELD" -eq 1 ]]; then
    rmdir "$CLAUDE_JSON_LOCK" 2>/dev/null || true
    CLAUDE_JSON_LOCK_HELD=0
  fi
}
# Release BOTH locks. Armed as a GLOBAL `trap cleanup_locks EXIT` below (before
# any dispatch), so it fires on normal exit, set -e abort, and SIGINT/SIGTERM —
# in delegated mode too (where acquire_lock returns before it could set a trap).
# Each release no-ops when its *_HELD flag is 0.
cleanup_locks() { release_lock; release_claude_json_lock; }

acquire_claude_json_lock() { # returns non-zero on timeout (caller warns, best-effort)
  local waited_ms=0 step_ms=100 max_ms=$(( CLAUDE_LOCK_WAIT_S * 1000 ))
  while ! mkdir "$CLAUDE_JSON_LOCK" 2>/dev/null; do
    if [[ -d "$CLAUDE_JSON_LOCK" ]]; then
      local mtime now age
      mtime=$(stat_mtime "$CLAUDE_JSON_LOCK" 2>/dev/null || echo "")
      now=$(date +%s)
      if [[ -n "$mtime" ]]; then
        age=$(( now - mtime ))
        if (( age > CLAUDE_LOCK_STALE_S )); then
          rmdir "$CLAUDE_JSON_LOCK" 2>/dev/null || true
          continue
        fi
      fi
    fi
    if (( waited_ms >= max_ms )); then return 1; fi
    sleep 0.1
    waited_ms=$(( waited_ms + step_ms ))
  done
  CLAUDE_JSON_LOCK_HELD=1
  return 0
}

acquire_lock() {
  # FLY-852 (QA-caught self-deadlock): the Node switch executor calls `use`
  # INSIDE its own withMkdirLock critical section on this SAME lock — taking it
  # again here would wait on our own parent until timeout. The parent delegates
  # by passing its pid; accept it ONLY when THREE things line up (Codex R3
  # HIGH-1: env+holder alone is forgeable — any same-user process can read the
  # holder pid and set the env):
  #   1. the env pid matches the LIVE holder-marker pid, AND
  #   2. that pid is OUR OWN PARENT ($PPID) — execFile spawns this script
  #      directly, so only a child genuinely spawned by the lock holder passes;
  #      a forger's parent is the forger, never the holder, AND
  #   3. the holder is alive.
  # Anything else falls through to a normal acquire (fail-safe). Delegated mode
  # neither takes nor releases the lock (the parent owns it): LOCK_HELD stays 0
  # so release_lock never touches it.
  if [[ -n "${FLYWHEEL_CLAUDE_LOCK_DELEGATED:-}" ]]; then
    local hpid holder=""
    holder=$(find_holder_marker 2>/dev/null || true)
    hpid=$(sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' "$holder" 2>/dev/null || true)
    if [[ -n "$hpid" && "$hpid" == "$FLYWHEEL_CLAUDE_LOCK_DELEGATED" && "$hpid" == "$PPID" ]] \
        && kill -0 "$hpid" 2>/dev/null; then
      DELEGATED_LOCK_ACCEPTED=1
      local delegated_token
      delegated_token=$(sed -n 's/.*"token":"\([^"]*\)".*/\1/p' "$holder" 2>/dev/null || true)
      [[ -n "$delegated_token" ]] || delegated_token="legacy-pid:$hpid"
      if [[ -z "${FLYWHEEL_LEASE_PROOF:-}" ]]; then
        FLYWHEEL_LEASE_PROOF=$(make_lease_proof "$holder" "$delegated_token")
        export FLYWHEEL_LEASE_PROOF
      fi
      lease_fence_or_fail
      return 0
    fi
  fi
  local deadline=$(( $(now_ms) + LOCK_TIMEOUT_MS ))
  mkdir -p "$(dirname "$LOCK_DIR")"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if lock_is_stale; then break_stale_lock || true; fi
    [[ $(now_ms) -ge $deadline ]] && fail "timeout acquiring lock $LOCK_DIR"
    sleep 0.05
  done
  LOCK_TOKEN="$$.$(now_ms).$RANDOM"
  LOCK_MARKER="$LOCK_DIR/holder.$$.$LOCK_TOKEN"
  local owner_start marker_written=0
  owner_start=$(process_start_time "$$")
  if [[ -n "$owner_start" ]]; then
    if printf '{"pid":%d,"at":%d,"token":"%s","processStartTime":"%s"}' \
      "$$" "$(now_ms)" "$LOCK_TOKEN" "$owner_start" > "$LOCK_MARKER"; then
      marker_written=1
    fi
  else
    if printf '{"pid":%d,"at":%d,"token":"%s"}' "$$" "$(now_ms)" "$LOCK_TOKEN" > "$LOCK_MARKER"; then
      marker_written=1
    fi
  fi
  if [[ "$marker_written" -ne 1 ]]; then
    rm -f "$LOCK_MARKER" 2>/dev/null || true
    rmdir "$LOCK_DIR" 2>/dev/null || true
    fail "failed to create owned marker for lock $LOCK_DIR"
  fi
  LOCK_HELD=1
  FLYWHEEL_LEASE_PROOF=$(make_lease_proof "$LOCK_MARKER" "$LOCK_TOKEN")
  export FLYWHEEL_LEASE_PROOF
}

# ------------------------------------------------------------- pool hygiene
# Codex code R1 MED-4: profile names are path components of a credentials pool
# — confine them to a strict allowlist (no '/', no '..', no leading '.', so a
# name can never escape the pool or collide with '.active').
require_valid_name() {
  local name="$1"
  case "$name" in
    "" ) fail "empty profile name" ;;
    .* ) fail "profile name '$name' must not start with '.'" ;;
    *[!A-Za-z0-9._-]* ) fail "profile name '$name' has characters outside [A-Za-z0-9._-] — refusing" ;;
    *..* ) fail "profile name '$name' contains '..' — refusing" ;;
  esac
}

require_pool_entry() { # $1 = name; refuses symlinks, requires an owner-only file
  local name="$1"
  require_valid_name "$name"
  local dir="$POOL_DIR/$name" file="$POOL_DIR/$name/.credentials.json"
  [[ -L "$POOL_DIR" ]] && fail "pool dir $POOL_DIR is a symlink — refusing"
  [[ -L "$dir" ]] && fail "profile dir $dir is a symlink — refusing"
  [[ -d "$dir" ]] || fail "pool profile '$name' not found ($dir)"
  [[ -L "$file" ]] && fail "credential file $file is a symlink — refusing"
  [[ -f "$file" ]] || fail "pool profile '$name' has no .credentials.json"
  # Codex code R1 MED-4: the credential file must be owner-only (0600/0400) —
  # a group/world-readable credential is refused fail-closed.
  local perms
  perms=$(stat_perms "$file") || fail "cannot stat $file"
  case "$perms" in
    600|400) : ;;
    *) fail "credential file $file has mode $perms (must be 600/400) — refusing" ;;
  esac
}

# ------------------------------------------------------- keychain primitives
kc_read() { # → stdout: current item value (non-zero when item missing)
  if [[ -n "$KEYCHAIN" ]]; then
    "$SEC_BIN" find-generic-password -a "$ACCT" -s "$SERVICE" -w "$KEYCHAIN"
  else
    "$SEC_BIN" find-generic-password -a "$ACCT" -s "$SERVICE" -w
  fi
}

kc_write() { # $1 = secret. NO-ARGV path: command incl. value goes via stdin (-i).
  local secret="$1"
  [[ -z "$secret" ]] && fail "empty credential — refusing to write"
  case "$secret" in
    "{"*) : ;;
    *) fail "credential is not a JSON object — refusing to write" ;;
  esac
  case "$secret" in
    *[[:space:]]*) fail "credential contains whitespace — refusing (security -i single-token rule)" ;;
  esac
  lease_fence_or_fail
  # printf is a bash BUILTIN: the secret never appears in any process argv.
  if [[ -n "$KEYCHAIN" ]]; then
    printf 'add-generic-password -U -a "%s" -s "%s" -w %s "%s"\n' \
      "$ACCT" "$SERVICE" "$secret" "$KEYCHAIN" | "$SEC_BIN" -i >/dev/null
  else
    printf 'add-generic-password -U -a "%s" -s "%s" -w %s\n' \
      "$ACCT" "$SERVICE" "$secret" | "$SEC_BIN" -i >/dev/null
  fi
}

# ------------------------------------------------- freshness guard (FLY-871 R1)
# Root-cure for the 2026-07-04 logout incident: before writing a NON-ACTIVE
# target to the Keychain, verify its pooled OAuth token is FRESH (probe-refresh).
# A stale pooled token (its refresh-token family rotated out) written to the
# machine Keychain logs out every live session. The verification is a small Node
# helper (HTTP+JSON — bash can't) run INSIDE this lock; credentials NEVER cross
# argv (the helper reads the pool file itself; only non-secret names are passed).
#
# default_freshness_bin: resolve the helper when FLYWHEEL_CLAUDE_FRESHNESS_BIN is
# unset — derived relative to this script (claude-runner/bin →
# teamlead/bin/flywheel-claude-freshness). Best-effort: prints an executable path
# or nothing (→ fail-closed exit 31).
default_freshness_bin() {
  local d cand
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || return 0
  cand="$d/../../teamlead/bin/flywheel-claude-freshness"
  [[ -x "$cand" ]] && printf '%s' "$cand"
}

# freshness_check <name> <active>: return 30 (target stale) / 31 (helper missing) /
# return 0 (fresh — the helper may have written a rotated credential back to the
# pool). Keychain/.active are UNTOUCHED on 30/31 (the incident root-cure). The
# guard runs unconditionally on `use`/`next` (manual + automatic) — plan §5: the
# manual stale-interception is part of the fix and is on at all times.
freshness_check() {
  local name="$1" active="$2"
  # Emergency HUMAN override. Honored ONLY on the manual path (NOT delegated-lock,
  # i.e. not the Bridge auto-switch): Codex R2#1 layer 2 — even if the env leaks
  # into the automatic path, delegated mode refuses it (the CLI also scrubs it,
  # layer 1). The name is deliberately alarming; use only with a human at the keys.
  if [[ -n "${FLYWHEEL_CLAUDE_FRESHNESS_BYPASS:-}" && "$DELEGATED_LOCK_ACCEPTED" -eq 0 ]]; then
    echo "Warning: FLYWHEEL_CLAUDE_FRESHNESS_BYPASS set — SKIPPING token freshness verification for '$name'. Emergency manual override; the switched-to token is NOT verified fresh and may strand live sessions if stale." >&2
    return 0
  fi
  local bin="${FLYWHEEL_CLAUDE_FRESHNESS_BIN:-}"
  [[ -z "$bin" ]] && bin="$(default_freshness_bin)"
  if [[ -z "$bin" || ! -x "$bin" ]]; then
    echo "FLYWHEEL_FRESHNESS_UNAVAILABLE $name" >&2
    echo "Error: token freshness helper unavailable (looked for '${bin:-<none>}') — refusing to switch to a possibly-stale credential (fail-closed). Set FLYWHEEL_CLAUDE_FRESHNESS_BIN, or FLYWHEEL_CLAUDE_FRESHNESS_BYPASS=1 for an emergency manual override." >&2
    return 31
  fi
  local rc=0
  "$bin" verify --name "$name" --active "$active" --pool "$POOL_DIR" || rc=$?
  case "$rc" in
    0) return 0 ;;
    39)
      echo "FLYWHEEL_LOCK_LEASE_LOST freshness write-back fenced" >&2
      return 39
      ;;
    30)
      echo "FLYWHEEL_TARGET_STALE $name" >&2
      echo "Error: target account '$name' has a stale pooled credential (freshness refresh refused) — Keychain/.active unchanged" >&2
      return 30
      ;;
    *)
      echo "FLYWHEEL_FRESHNESS_UNAVAILABLE $name" >&2
      echo "Error: freshness helper exited $rc for '$name' — refusing to switch (fail-closed)" >&2
      return 31
      ;;
  esac
}

# --------------------------------------------------------- live quota guard (FLY-1252)
default_quota_guard_bin() {
  local d cand
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || return 0
  cand="$d/../../teamlead/bin/flywheel-claude-quota-guard"
  [[ -x "$cand" ]] && printf '%s' "$cand"
}

default_lead_alert_bin() {
  local d cand
  d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || return 0
  cand="$d/../../../scripts/lead-alert.sh"
  [[ -x "$cand" ]] && printf '%s' "$cand"
}

# Manual emergency bypasses are never silent. Alert delivery is best-effort so
# an emergency recovery cannot be blocked by a broken Discord path.
emit_quota_bypass_alert() {
  local name="$1" bin="${FLYWHEEL_LEAD_ALERT_BIN:-}" epoch observed_at result="" rc=0
  [[ -z "$bin" ]] && bin="$(default_lead_alert_bin)"
  if [[ -z "$bin" || ! -x "$bin" ]]; then
    echo "Warning: quota bypass alert helper unavailable; bypass remains visible only in this terminal" >&2
    return 0
  fi
  epoch=$(date +%s)
  observed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  # launchd and other sparse callers may not have alert credentials in their
  # environment. Load the shared .env inside a child shell, preserving the
  # small alert-related process-env allowlist in memory. Never serialize the
  # caller's exported environment (and its secrets) to a temporary file.
  result=$(
    env_file="${FLYWHEEL_STATE_DIR:-$HOME/.flywheel}/.env"
    preserve_names=(
      HOME FLYWHEEL_STATE_DIR FLYWHEEL_ALERT_DEADLETTER_DIR
      FLYWHEEL_ALERT_QUEUE_DIR FLYWHEEL_ALERT_RATE_PER_MIN
      FLYWHEEL_ALERT_SENDER_TOKEN_ENV FLYWHEEL_ALERT_TICKETS
      FLYWHEEL_CLAIMS_DB FLYWHEEL_PROJECTS_FILE
      FLYWHEEL_UNIFIED_ALERT_CHANNEL_ID
    )
    sender_name="${FLYWHEEL_ALERT_SENDER_TOKEN_ENV:-}"
    if [[ "$sender_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      preserve_names+=("$sender_name")
    fi
    preserve_set=()
    preserve_values=()
    for preserve_name in "${preserve_names[@]}"; do
      if [[ "${!preserve_name+x}" == "x" ]]; then
        preserve_set+=(1)
        preserve_values+=("${!preserve_name}")
      else
        preserve_set+=(0)
        preserve_values+=("")
      fi
    done
    if [[ -f "$env_file" ]]; then
      set -a
      # shellcheck source=/dev/null
      source "$env_file" || true
      set +a
      for preserve_idx in "${!preserve_names[@]}"; do
        if [[ "${preserve_set[$preserve_idx]}" -eq 1 ]]; then
          export "${preserve_names[$preserve_idx]}=${preserve_values[$preserve_idx]}"
        fi
      done
    fi
    "$bin" \
      --lead quota-monitor --project flywheel \
      --kind quota_guard_bypassed --severity warning \
      --title "Claude quota guard BYPASSED manually" \
      --body "target=$name; at=$observed_at; pid=$$; manual emergency bypass of quota verification (FLYWHEEL_CLAUDE_QUOTA_BYPASS=1) — target quota NOT verified" \
      --signature "quota-guard-bypass-$name-$epoch-$$" \
      --strict-delivery 2>/dev/null
  ) || rc=$?
  case "$result" in
    sent|queued_transient)
      echo "Warning: quota bypass audit alert accepted ($result)" >&2
      ;;
    *) echo "Warning: quota bypass alert delivery was not confirmed (result=${result:-none}, rc=$rc)" >&2 ;;
  esac
  return 0
}

# quota_check <name>: 0 healthy, 32 definitely exhausted, 33 evidence
# unavailable. Only an AUTHENTICATED delegated child may honor PREVERIFIED;
# raw ambient env values do not establish trust. Legacy delegated callers that
# lack PREVERIFIED retain their historical fail-open behavior for 33 only.
quota_check() {
  local name="$1" bin="${FLYWHEEL_CLAUDE_QUOTA_GUARD_BIN:-}" rc=0
  if [[ "$DELEGATED_LOCK_ACCEPTED" -eq 1 && "${FLYWHEEL_CLAUDE_QUOTA_PREVERIFIED:-}" == "1" ]]; then
    return 0
  fi
  if [[ "$DELEGATED_LOCK_ACCEPTED" -eq 0 && "${FLYWHEEL_CLAUDE_QUOTA_BYPASS:-}" == "1" ]]; then
    echo "Warning: FLYWHEEL_CLAUDE_QUOTA_BYPASS=1 — BYPASSING live 5h/7d quota guard for '$name'. Emergency manual override; target quota is NOT verified." >&2
    emit_quota_bypass_alert "$name"
    return 0
  fi
  [[ -z "$bin" ]] && bin="$(default_quota_guard_bin)"
  if [[ -z "$bin" || ! -x "$bin" ]]; then
    rc=33
  else
    "$bin" check --name "$name" --pool "$POOL_DIR" --store "$ACCOUNTS_STORE" || rc=$?
    case "$rc" in
      0|32|33|39) : ;;
      *) rc=33 ;;
    esac
  fi
  case "$rc" in
    0) return 0 ;;
    39)
      echo "FLYWHEEL_LOCK_LEASE_LOST quota projection fenced" >&2
      return 39
      ;;
    32)
      echo "FLYWHEEL_TARGET_QUOTA_EXHAUSTED $name" >&2
      echo "Error: target account '$name' is exhausted in its live 5h or 7d quota window — Keychain/.active unchanged" >&2
      return 32
      ;;
    33)
      if [[ "$DELEGATED_LOCK_ACCEPTED" -eq 1 ]]; then
        echo "Warning: live quota evidence unavailable for '$name' in legacy delegated mode; proceeding for backward compatibility (set FLYWHEEL_CLAUDE_QUOTA_PREVERIFIED=1 after an upstream live check)" >&2
        return 0
      fi
      echo "FLYWHEEL_QUOTA_UNAVAILABLE $name" >&2
      echo "Error: live quota evidence unavailable for '$name' — refusing manual switch (fail-closed). Set FLYWHEEL_CLAUDE_QUOTA_BYPASS=1 only for an emergency manual override." >&2
      return 33
      ;;
  esac
}

# Best-effort projection of the already-committed machine profile marker into
# claude-accounts.json. Manual use/next own the shared lock here. Delegated Node
# switching is already the store writer, so it must not double-bump generation.
active_sync_store() {
  local name="$1" force="${2:-}" bin="${FLYWHEEL_CLAUDE_QUOTA_GUARD_BIN:-}" rc=0
  [[ "$DELEGATED_LOCK_ACCEPTED" -eq 1 && "$force" != "force" ]] && return 0
  [[ -z "$bin" ]] && bin="$(default_quota_guard_bin)"
  if [[ -z "$bin" || ! -x "$bin" ]]; then
    echo "Warning: active account store sync helper unavailable after switching to '$name'; Keychain/.active remain committed" >&2
    return 0
  fi
  lease_fence_or_fail
  "$bin" active-sync --name "$name" --store "$ACCOUNTS_STORE" || rc=$?
  [[ "$rc" -eq 39 ]] && return 39
  if [[ "$rc" -ne 0 ]]; then
    echo "Warning: active account store sync failed after switching to '$name' (rc=$rc); Keychain/.active remain committed" >&2
  fi
  return 0
}

# capture_back <active> <value>: FLY-871 R1/C1 — before we overwrite the Keychain,
# snapshot the CURRENT value (the OLD active account's live token, which claude
# may have refreshed since capture) into its pool slot, so a later switch BACK to
# it uses the freshest credential the machine held. BEST-EFFORT: any problem only
# warns to stderr (never fails the switch — the switch is the priority). Refuses a
# non-JSON-object / whitespace value and symlinked targets (never poison the pool).
capture_back() {
  local active="$1" value="$2"
  case "$active" in
    ""|.*|*[!A-Za-z0-9._-]*|*..*)
      echo "Warning: skipping capture-back — invalid active name '$active'" >&2; return 0 ;;
  esac
  case "$value" in
    "{"*) : ;;
    *) echo "Warning: skipping capture-back for '$active' (current Keychain value is not a JSON object)" >&2; return 0 ;;
  esac
  case "$value" in
    *[[:space:]]*) echo "Warning: skipping capture-back for '$active' (value has whitespace)" >&2; return 0 ;;
  esac
  local dir="$POOL_DIR/$active" file="$POOL_DIR/$active/.credentials.json"
  [[ -L "$POOL_DIR" ]] && { echo "Warning: pool dir is a symlink — skipping capture-back" >&2; return 0; }
  [[ -L "$dir" ]] && { echo "Warning: profile dir $dir is a symlink — skipping capture-back" >&2; return 0; }
  [[ -d "$dir" ]] || { echo "Warning: active profile dir $dir missing — skipping capture-back for '$active'" >&2; return 0; }
  [[ -L "$file" ]] && { echo "Warning: credential file $file is a symlink — skipping capture-back" >&2; return 0; }
  lease_fence_or_fail
  ( umask 077; printf '%s' "$value" > "$file.tmp" ) || { echo "Warning: capture-back write failed for '$active'" >&2; return 0; }
  lease_fence_or_fail
  mv "$file.tmp" "$file" 2>/dev/null || { echo "Warning: capture-back rename failed for '$active'" >&2; rm -f "$file.tmp" 2>/dev/null || true; return 0; }
  chmod 600 "$file" 2>/dev/null || true
  echo "Captured-back current credential for active profile '$active' before switch" >&2
}

# ------------------------------------------------ transition journal (FLY-1252)
digest_value() {
  if command -v shasum >/dev/null 2>&1; then
    printf '%s' "$1" | shasum -a 256 | awk '{print $1}'
  else
    printf '%s' "$1" | sha256sum | awk '{print $1}'
  fi
}

lease_token_from_proof() {
  FLYWHEEL_LEASE_PROOF_VALUE="$FLYWHEEL_LEASE_PROOF" "$NODE_BIN" -e '
    try { const p=JSON.parse(process.env.FLYWHEEL_LEASE_PROOF_VALUE); if(typeof p.ownershipToken!=="string") process.exit(1); process.stdout.write(p.ownershipToken); }
    catch { process.exit(1); }
  '
}

write_transition_journal() { # <old-label> <target-label> <old-value> <target-value> -> opId
  local old_label="$1" target_label="$2" old_digest target_digest writer_pgid leader_start lease_token op_id
  old_digest=$(digest_value "$3")
  target_digest=$(digest_value "$4")

  # Detached mutation leaders have pgid==pid. Sandboxed test runners may forbid
  # ps(1), so fall back to that construction; production also verifies group
  # liveness with kill(-pgid,0), not a ps text scrape.
  writer_pgid=$("$PS_BIN" -o pgid= -p $$ 2>/dev/null | tr -d ' ' || true)
  [[ "$writer_pgid" =~ ^[0-9]+$ ]] || writer_pgid="$$"
  [[ "$writer_pgid" =~ ^[0-9]+$ ]] || fail "cannot determine mutation process group"
  leader_start=$(process_start_time "$$")
  [[ -n "$leader_start" ]] || leader_start="started-before-$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  lease_token=$(lease_token_from_proof) || fail_code 39 "cannot read lease token before transition"
  op_id="$(date +%s).$$.$RANDOM"
  lease_fence_or_fail
  "$NODE_BIN" --input-type=module - "$TRANSITION_JOURNAL" "$op_id" "$(id -u)" "$writer_pgid" "$$" "$leader_start" "$lease_token" "$old_label" "$target_label" "$old_digest" "$target_digest" <<'NODE'
import { closeSync, fsyncSync, lstatSync, mkdirSync, openSync, renameSync, writeSync } from "node:fs";
import { dirname } from "node:path";
const [path,opId,writerUid,writerPgid,leaderPid,leaderStartTime,writerLeaseToken,oldLabel,targetLabel,oldDigest,targetDigest]=process.argv.slice(2);
try { if (lstatSync(path).isSymbolicLink()) throw new Error("journal is symlink"); } catch (e) { if (e?.code !== "ENOENT") throw e; }
const body=JSON.stringify({opId,writerUid:Number(writerUid),writerPgid:Number(writerPgid),leaderPid:Number(leaderPid),leaderStartTime,writerLeaseToken,oldLabel,targetLabel,oldDigest,targetDigest,startedAt:new Date().toISOString()})+"\n";
mkdirSync(dirname(path),{recursive:true,mode:0o700});
const tmp=`${path}.tmp.${process.pid}`;
const fd=openSync(tmp,"wx",0o600);
try { writeSync(fd,body); fsyncSync(fd); } finally { closeSync(fd); }
renameSync(tmp,path);
NODE
  printf '%s' "$op_id"
}

clear_transition_journal() { # optional expected op id
  local expected="${1:-}"
  lease_fence_or_fail
  "$NODE_BIN" --input-type=module - "$TRANSITION_JOURNAL" "$expected" <<'NODE'
import { lstatSync, readFileSync, unlinkSync } from "node:fs";
const [path,expected]=process.argv.slice(2);
let stat;
try { stat=lstatSync(path); } catch (e) { if (e?.code === "ENOENT") process.exit(0); throw e; }
if (stat.isSymbolicLink() || !stat.isFile()) process.exit(1);
if (expected) {
  let parsed; try { parsed=JSON.parse(readFileSync(path,"utf8")); } catch { process.exit(1); }
  if (parsed?.opId !== expected) process.exit(1);
}
unlinkSync(path);
NODE
}

process_group_alive() { # 0 alive; 1 empty; 2 unknown
  "$NODE_BIN" -e '
    const pgid=Number(process.argv[1]);
    if(!Number.isInteger(pgid)||pgid<=0) process.exit(2);
    try { process.kill(-pgid,0); process.exit(0); }
    catch(e) { if(e?.code==="ESRCH") process.exit(1); if(e?.code==="EPERM") process.exit(0); process.exit(2); }
  ' "$1"
}

read_store_generation_for_active() { # <label>
  "$NODE_BIN" --input-type=module - "$ACCOUNTS_STORE" "$1" <<'NODE'
import { readFileSync } from "node:fs";
const [path,label]=process.argv.slice(2);
let store; try { store=JSON.parse(readFileSync(path,"utf8")); } catch { process.exit(1); }
if (!Number.isInteger(store?.generation) || store.generation < 0 || store.activeAccount !== label || !Array.isArray(store.accounts) || !store.accounts.some((a)=>a?.name===label)) process.exit(1);
process.stdout.write(String(store.generation));
NODE
}

write_active_from_reconcile() { # <label>
  require_valid_name "$1"
  [[ -d "$POOL_DIR/$1" ]] || return 1
  lease_fence_or_fail
  ( umask 077; printf '%s' "$1" > "$ACTIVE_FILE.tmp" )
  lease_fence_or_fail
  mv "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
}

reconcile_transition_journal() {
  [[ -e "$TRANSITION_JOURNAL" || -L "$TRANSITION_JOURNAL" ]] || { echo '{"outcome":"none"}'; return 0; }
  local fields rc=0
  fields=$("$NODE_BIN" --input-type=module - "$TRANSITION_JOURNAL" <<'NODE'
import { lstatSync, readFileSync } from "node:fs";
const path=process.argv[2];
try {
  const st=lstatSync(path); if(st.isSymbolicLink()||!st.isFile()) process.exit(1);
  const j=JSON.parse(readFileSync(path,"utf8"));
  const label=/^(?!\.)(?!.*\.\.)[A-Za-z0-9._-]+$/; const digest=/^[a-f0-9]{64}$/;
  if(typeof j.opId!=="string"||!Number.isInteger(j.writerUid)||!Number.isInteger(j.writerPgid)||j.writerPgid<=0||!Number.isInteger(j.leaderPid)||j.leaderPid<=0||typeof j.leaderStartTime!=="string"||typeof j.writerLeaseToken!=="string"||typeof j.oldLabel!=="string"||!label.test(j.targetLabel)||!digest.test(j.oldDigest)||!digest.test(j.targetDigest)||typeof j.startedAt!=="string") process.exit(1);
  process.stdout.write([j.opId,j.writerUid,j.writerPgid,j.leaderPid,j.leaderStartTime,j.oldLabel,j.targetLabel,j.oldDigest,j.targetDigest].join("\t"));
} catch { process.exit(1); }
NODE
  ) || rc=$?
  if [[ "$rc" -ne 0 || -z "$fields" ]]; then echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; fi
  local op_id writer_uid writer_pgid leader_pid leader_start old_label target_label old_digest target_digest
  IFS=$'\t' read -r op_id writer_uid writer_pgid leader_pid leader_start old_label target_label old_digest target_digest <<<"$fields"
  if [[ "$writer_uid" != "$(id -u)" ]]; then echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; fi
  if process_group_alive "$writer_pgid"; then echo '{"outcome":"writer_alive"}'; return 0; else rc=$?; fi
  [[ "$rc" -eq 1 ]] || { echo '{"outcome":"writer_alive"}'; return 0; }
  local current current_digest generation
  current=$(kc_read 2>/dev/null) || { echo '{"outcome":"conflict","reason":"keychain_unreadable"}'; return 0; }
  current_digest=$(digest_value "$current")
  if [[ "$current_digest" == "$old_digest" ]]; then
    clear_transition_journal "$op_id" || { echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; }
    echo '{"outcome":"cleared"}'
    return 0
  fi
  if [[ "$current_digest" == "$target_digest" ]]; then
    write_active_from_reconcile "$target_label" || { echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; }
    active_sync_store "$target_label" force || { echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; }
    generation=$(read_store_generation_for_active "$target_label") || { echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; }
    clear_transition_journal "$op_id" || { echo '{"outcome":"conflict","reason":"malformed_journal"}'; return 0; }
    printf '{"outcome":"completed","activeAccount":"%s","generation":%s}\n' "$target_label" "$generation"
    return 0
  fi
  echo '{"outcome":"conflict","reason":"digest_mismatch_both"}'
}

reconcile_after_acquire() {
  local result
  result=$(reconcile_transition_journal)
  case "$result" in
    *'"outcome":"none"'*|*'"outcome":"cleared"'*|*'"outcome":"completed"'*) return 0 ;;
    *'"outcome":"writer_alive"'*) fail "switch in progress, retry shortly (transition writer group still alive)" ;;
    *) fail "transition journal conflict — refusing account mutation: $result" ;;
  esac
}

CAPTURE_RECOVERY_OP=""

read_capture_recovery_fields() {
  "$NODE_BIN" --input-type=module - "$TRANSITION_JOURNAL" <<'NODE'
import { lstatSync, readFileSync } from "node:fs";
const path=process.argv[2];
try {
  const st=lstatSync(path);
  if(st.isSymbolicLink()||!st.isFile()) process.exit(1);
  const j=JSON.parse(readFileSync(path,"utf8"));
  const label=/^(?!\.)(?!.*\.\.)[A-Za-z0-9._-]+$/;
  if(typeof j.opId!=="string"||j.opId.length===0||typeof j.targetLabel!=="string"||!label.test(j.targetLabel)) process.exit(1);
  process.stdout.write(`${j.opId}\t${j.targetLabel}`);
} catch { process.exit(1); }
NODE
}

# A crash followed by an operator re-login legitimately makes the Keychain
# digest match neither journal endpoint. Allow only `capture <targetLabel>` to
# recover that explicit target; every other mutation remains fail-closed.
reconcile_before_capture() { # <capture name>
  local name="$1" result fields op_id target_label
  CAPTURE_RECOVERY_OP=""
  result=$(reconcile_transition_journal)
  case "$result" in
    *'"outcome":"none"'*|*'"outcome":"cleared"'*|*'"outcome":"completed"'*) return 0 ;;
    *'"outcome":"writer_alive"'*) fail "switch in progress, retry shortly (transition writer group still alive)" ;;
    *'"outcome":"conflict"'*'"reason":"digest_mismatch_both"'*)
      fields=$(read_capture_recovery_fields) || fail "transition journal conflict is not recoverable by capture: $result"
      IFS=$'\t' read -r op_id target_label <<<"$fields"
      [[ "$name" == "$target_label" ]] || fail "transition journal recovery requires: log into '$target_label' first, then run: flywheel-claude-profile capture $target_label"
      CAPTURE_RECOVERY_OP="$op_id"
      return 0
      ;;
    *) fail "transition journal conflict — refusing account mutation: $result" ;;
  esac
}

# ------------------------------------------------------- display identity (FLY-865)
# An account's DISPLAY identity (the `oauthAccount` block `/status` reads: email/
# org/uuid) lives in ~/.claude.json, NOT in the Keychain token. Switching the
# token alone left the display on the old account (FLY-865). We snapshot the
# identity beside the pooled token on `capture` and write it back on `use`.
#
# All identity IO is BEST-EFFORT: the token switch (verify-before-commit above)
# is authoritative, so a failed identity read/write only warns and returns 0 —
# it must NEVER turn a committed token switch into a non-zero exit (the Node
# switch executor treats non-zero `use` as "switch failed, state untouched").
# The opaque token cannot be decoded to an identity, so capture/restore is the
# only mechanism; we NEVER clear oauthAccount (undocumented refetch + risks the
# "never break the claude login" red line).

# require_identity_entry: 0 ok, 1 present-but-unusable (symlink / non-file /
# not 0600-0400; warns), 2 missing (caller emits the re-capture hint).
require_identity_entry() {
  local f="$1" perms
  if [[ -L "$f" ]]; then echo "Warning: identity file $f is a symlink — refusing" >&2; return 1; fi
  if [[ ! -e "$f" ]]; then return 2; fi
  if [[ ! -f "$f" ]]; then echo "Warning: identity file $f is not a regular file — refusing" >&2; return 1; fi
  perms=$(stat_perms "$f") || { echo "Warning: cannot stat identity file $f — refusing" >&2; return 1; }
  case "$perms" in
    600|400) : ;;
    *) echo "Warning: identity file $f has mode $perms (must be 600/400) — refusing" >&2; return 1 ;;
  esac
  return 0
}

# extract_claude_identity <claude.json> <out>: validate $1 has a real oauthAccount
# object and atomically write it to $2 (0600); print its email on stdout. Non-zero
# (no side effect on $2) when there is no valid oauthAccount to capture.
extract_claude_identity() {
  node --input-type=module - "$1" "$2" <<'NODE'
import { readFileSync, writeFileSync, renameSync, chmodSync, unlinkSync } from "node:fs";
const [target, out] = process.argv.slice(2);
const REQ = ["accountUuid", "emailAddress", "organizationUuid", "organizationName"];
const isValidIdentity = (o) =>
  o !== null && typeof o === "object" && !Array.isArray(o) &&
  REQ.every((k) => typeof o[k] === "string" && o[k].length > 0);
let obj;
try { obj = JSON.parse(readFileSync(target, "utf-8")); }
catch { process.stderr.write(`cannot parse ${target}\n`); process.exit(1); }
const oa = obj !== null && typeof obj === "object" && !Array.isArray(obj) ? obj.oauthAccount : undefined;
if (!isValidIdentity(oa)) { process.stderr.write(`no valid oauthAccount in ${target}\n`); process.exit(1); }
let tmp;
for (let i = 0; i < 8; i++) {
  const cand = `${out}.fly865.${process.pid}.${i}`;
  try { writeFileSync(cand, JSON.stringify(oa), { flag: "wx", mode: 0o600 }); tmp = cand; break; }
  catch (e) { if (e && e.code !== "EEXIST") { process.stderr.write(`write failed: ${e.message}\n`); process.exit(1); } }
}
if (tmp === undefined) { process.stderr.write(`could not create temp for ${out}\n`); process.exit(1); }
try { chmodSync(tmp, 0o600); renameSync(tmp, out); }
catch (e) { try { unlinkSync(tmp); } catch {} process.stderr.write(`rename failed: ${e.message}\n`); process.exit(1); }
process.stdout.write(`${oa.emailAddress}\n`);
NODE
}

# patch_claude_json_identity <identity-src> <claude.json>: validate both, then
# atomically replace ONLY the oauthAccount field of $2 with $1 (all other keys
# preserved, mode preserved), with a post-write read-back verify. Print the
# applied email on stdout. Non-zero (target byte-untouched) on any failure.
# MUST be called with CLAUDE_JSON_LOCK held.
patch_claude_json_identity() {
  node --input-type=module - "$1" "$2" <<'NODE'
import { readFileSync, writeFileSync, renameSync, chmodSync, statSync, lstatSync, unlinkSync } from "node:fs";
const [src, target] = process.argv.slice(2);
const REQ = ["accountUuid", "emailAddress", "organizationUuid", "organizationName"];
const isValidIdentity = (o) =>
  o !== null && typeof o === "object" && !Array.isArray(o) &&
  REQ.every((k) => typeof o[k] === "string" && o[k].length > 0);
// Refuse a symlinked target INSIDE the locked write path (Codex R2#1).
let st;
try { st = lstatSync(target); } catch { process.stderr.write(`cannot lstat ${target}\n`); process.exit(1); }
if (st.isSymbolicLink()) { process.stderr.write(`${target} is a symlink — refusing to write display identity\n`); process.exit(1); }
let identity;
try { identity = JSON.parse(readFileSync(src, "utf-8")); }
catch { process.stderr.write(`cannot parse identity ${src}\n`); process.exit(1); }
if (!isValidIdentity(identity)) { process.stderr.write(`invalid identity object in ${src}\n`); process.exit(1); }
let obj;
try { obj = JSON.parse(readFileSync(target, "utf-8")); }
catch { process.stderr.write(`${target} is not valid JSON — refusing to overwrite\n`); process.exit(1); }
if (obj === null || typeof obj !== "object" || Array.isArray(obj)) { process.stderr.write(`${target} is not a JSON object — refusing\n`); process.exit(1); }
obj.oauthAccount = identity;
const mode = statSync(target).mode & 0o777;
let tmp;
for (let i = 0; i < 8; i++) {
  const cand = `${target}.fly865.${process.pid}.${i}`;
  try { writeFileSync(cand, JSON.stringify(obj), { flag: "wx", mode }); tmp = cand; break; }
  catch (e) { if (e && e.code !== "EEXIST") { process.stderr.write(`write failed: ${e.message}\n`); process.exit(1); } }
}
if (tmp === undefined) { process.stderr.write(`could not create temp near ${target}\n`); process.exit(1); }
try { chmodSync(tmp, mode); renameSync(tmp, target); }
catch (e) { try { unlinkSync(tmp); } catch {} process.stderr.write(`rename failed: ${e.message}\n`); process.exit(1); }
// Post-write read-back verify — detect a concurrent (non-lock-respecting) clobber
// (Codex R2#5). Compare the FULL required identity subset, not just email (a
// same-email/different-org clobber must not pass — /status shows org too).
try {
  const after = JSON.parse(readFileSync(target, "utf-8"));
  const oa = after && after.oauthAccount;
  if (!oa || REQ.some((k) => oa[k] !== identity[k])) {
    process.stderr.write(`post-write verify mismatch (concurrent write?)\n`); process.exit(1);
  }
} catch { process.stderr.write(`post-write verify read failed\n`); process.exit(1); }
process.stdout.write(`${identity.emailAddress}\n`);
NODE
}

# capture_identity <name>: snapshot the CURRENT ~/.claude.json oauthAccount beside
# the just-captured token. If there is no valid identity to capture, DELETE any
# stale oauthAccount.json for this profile so a fresh token is never paired with
# an old identity (Codex R1#2). Best-effort — always returns 0.
capture_identity() {
  # Separate declarations: a combined `local name="$1" out="…$name…"` would
  # expand the CALLER's dynamically-scoped `name`, not this one (ShellCheck SC2318).
  local name="$1" email=""
  local out="$POOL_DIR/$name/oauthAccount.json"
  if [[ -L "$out" ]]; then
    echo "Warning: $out is a symlink — refusing to capture display identity for '$name'" >&2
    return 0
  fi
  if [[ ! -f "$CLAUDE_JSON" ]]; then
    echo "Warning: $CLAUDE_JSON not found — no display identity captured for '$name'. Log into '$name' then re-run: flywheel-claude-profile capture $name" >&2
    rm -f "$out" 2>/dev/null || true
    return 0
  fi
  if email=$(extract_claude_identity "$CLAUDE_JSON" "$out"); then
    echo "Captured display identity for '$name' (email: ${email:-unknown})"
  else
    echo "Warning: $CLAUDE_JSON has no valid oauthAccount — no display identity captured for '$name'. Log into '$name' then re-run: flywheel-claude-profile capture $name" >&2
    rm -f "$out" 2>/dev/null || true
  fi
  return 0
}

# sync_identity <name>: write the pooled identity for <name> into ~/.claude.json
# (serialized on CLAUDE_JSON_LOCK). Best-effort — ALWAYS returns 0. Identity
# messages go to STDERR so `use` STDOUT keeps its single "Switched…" line.
sync_identity() {
  # Separate declarations (ShellCheck SC2318): a combined local with `$name` in
  # the RHS would read the caller's dynamically-scoped `name`, not this one.
  local name="$1" rc=0 email=""
  local src="$POOL_DIR/$name/oauthAccount.json"
  # `; rc=$?` would let set -e abort on a non-zero return before capturing it.
  require_identity_entry "$src" || rc=$?
  if [[ $rc -eq 2 ]]; then
    echo "Warning: profile '$name' has no captured display identity (oauthAccount.json). The machine Keychain token was switched, but ~/.claude.json display identity was NOT updated — a new claude '/status' may show a stale account. To fix: log into '$name' once, then run: flywheel-claude-profile capture $name" >&2
    return 0
  fi
  if [[ $rc -ne 0 ]]; then
    echo "Warning: display identity for '$name' NOT applied (token switched OK)." >&2
    return 0
  fi
  if [[ ! -f "$CLAUDE_JSON" ]]; then
    echo "Warning: $CLAUDE_JSON not found — display identity NOT updated for '$name' (token switched OK)." >&2
    return 0
  fi
  if ! acquire_claude_json_lock; then
    echo "Warning: could not acquire $CLAUDE_JSON_LOCK within ${CLAUDE_LOCK_WAIT_S}s — display identity NOT updated for '$name' (token switched OK)." >&2
    return 0
  fi
  lease_fence_or_fail
  if email=$(patch_claude_json_identity "$src" "$CLAUDE_JSON"); then
    release_claude_json_lock
    echo "Updated ~/.claude.json display identity to '$name' (email: ${email:-unknown})" >&2
  else
    release_claude_json_lock
    echo "Warning: failed to update ~/.claude.json display identity for '$name' (token switched OK; a new claude '/status' may show a stale account)." >&2
  fi
  return 0
}

# ------------------------------------------------------------------ commands
get_active() { [[ -f "$ACTIVE_FILE" ]] && cat "$ACTIVE_FILE" || echo ""; }

list_profiles() {
  local active found=0 name
  active=$(get_active)
  for dir in "$POOL_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    name=$(basename "$dir")
    found=1
    [[ "$name" == "$active" ]] && echo "* $name" || echo "  $name"
  done
  [[ $found -eq 0 ]] && echo "No profiles in pool $POOL_DIR."
  return 0
}

show_status() {
  local active
  active=$(get_active)
  [[ -z "$active" ]] && echo "No active profile set." || echo "Active profile: $active"
}

prepare_profile_locked() { # <name> <active>; returns 0/30/31/32/33
  local name="$1" active="$2" rc=0
  require_pool_entry "$name"
  if [[ "$name" != "$active" ]]; then
    freshness_check "$name" "$active" || rc=$?
    [[ "$rc" -eq 0 ]] || return "$rc"
  fi
  quota_check "$name" || rc=$?
  return "$rc"
}

# Commit boundary: no probes here. The caller has prepared exactly once and
# renewed its lease. Revalidate/re-read because freshness may have atomically
# rotated the pooled credential.
commit_profile_locked() { # <name> <active>
  local name="$1" active="$2"
  local new backup="" got journal_op sync_rc=0
  require_pool_entry "$name"
  new=$(cat "$POOL_DIR/$name/.credentials.json")
  renew_lock_or_fail
  # Snapshot the current value so a failed verify can roll back — the red line
  # is "switching must never leave the claude login broken".
  backup=$(kc_read 2>/dev/null || true)

  # FLY-871 R1/C1 — capture-back the OLD active account's current Keychain value
  # into its pool slot before we overwrite it (best-effort; see capture_back).
  if [[ -n "$active" && "$active" != "$name" ]]; then
    capture_back "$active" "$backup"
  fi

  journal_op=$(write_transition_journal "$active" "$name" "$backup" "$new")
  if [[ -n "${FLYWHEEL_TEST_PAUSE_AFTER_JOURNAL:-}" ]]; then
    : > "${FLYWHEEL_TEST_PAUSE_AFTER_JOURNAL}.ready"
    while [[ ! -e "${FLYWHEEL_TEST_PAUSE_AFTER_JOURNAL}.continue" ]]; do sleep 0.01; done
  fi
  lease_fence_or_fail
  kc_write "$new" # fail-closed: any non-zero aborts (set -e), .active untouched

  lease_fence_or_fail
  got=$(kc_read 2>/dev/null || true)
  if [[ "$got" != "$new" ]]; then
    if [[ -n "$backup" ]]; then
      if kc_write "$backup" 2>/dev/null; then
        fail "verify-before-commit failed (read-back mismatch) — rolled back to the previous credential; .active unchanged"
      else
        fail "verify-before-commit failed AND rollback failed — Keychain may be inconsistent for service '$SERVICE'; manual check required"
      fi
    fi
    fail "verify-before-commit failed (read-back mismatch, no previous value to roll back) — .active unchanged"
  fi

  lease_fence_or_fail
  printf '%s' "$name" > "$ACTIVE_FILE.tmp"
  lease_fence_or_fail
  mv "$ACTIVE_FILE.tmp" "$ACTIVE_FILE"
  active_sync_store "$name" || sync_rc=$?
  [[ "$sync_rc" -eq 39 ]] && exit 39
  # FLY-865: swap the DISPLAY identity too (best-effort; never fails the switch).
  sync_identity "$name"
  clear_transition_journal "$journal_op"
  echo "Switched machine Claude account to profile '$name' (new spawns use it; live sessions wait for reset)"
}

switch_profile_locked() { # <name> <active>; prepare exactly once, then commit
  local name="$1" active="$2" rc=0
  prepare_profile_locked "$name" "$active" || rc=$?
  [[ "$rc" -eq 0 ]] || return "$rc"
  commit_profile_locked "$name" "$active"
}

use_profile() {
  local name="$1" active rc=0
  acquire_lock
  reconcile_after_acquire
  lease_fence_or_fail
  mkdir -p "$POOL_DIR"
  chmod 700 "$POOL_DIR" 2>/dev/null || true
  require_pool_entry "$name"
  active=$(get_active)
  switch_profile_locked "$name" "$active" || rc=$?
  [[ "$rc" -eq 0 ]] || exit "$rc"
}

next_profile() {
  local active profiles=() name rc=0
  acquire_lock
  reconcile_after_acquire
  lease_fence_or_fail
  mkdir -p "$POOL_DIR"
  chmod 700 "$POOL_DIR" 2>/dev/null || true
  active=$(get_active)
  for dir in "$POOL_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    profiles+=("$(basename "$dir")")
  done
  [[ ${#profiles[@]} -eq 0 ]] && fail "no profiles in pool $POOL_DIR"
  [[ ${#profiles[@]} -eq 1 ]] && fail "only one profile in pool: ${profiles[0]}"
  IFS=$'\n' profiles=($(sort <<<"${profiles[*]}")); unset IFS
  local idx=-1 i candidate_count offset candidate_idx candidate
  for i in "${!profiles[@]}"; do
    [[ "${profiles[$i]}" == "$active" ]] && { idx=$i; break; }
  done
  if [[ "$idx" -ge 0 ]]; then
    candidate_count=$(( ${#profiles[@]} - 1 ))
  else
    candidate_count=${#profiles[@]}
  fi

  offset=1
  while [[ "$offset" -le "$candidate_count" ]]; do
    candidate_idx=$(( (idx + offset) % ${#profiles[@]} ))
    candidate="${profiles[$candidate_idx]}"
    renew_lock_or_fail
    rc=0
    prepare_profile_locked "$candidate" "$active" || rc=$?
    case "$rc" in
      0)
        renew_lock_or_fail
        commit_profile_locked "$candidate" "$active"
        return 0
        ;;
      32)
        echo "Skipping exhausted quota candidate '$candidate'" >&2
        ;;
      30|31|33|39)
        exit "$rc"
        ;;
      *)
        fail "unexpected candidate preparation result $rc for '$candidate'"
        ;;
    esac
    offset=$(( offset + 1 ))
  done
  echo "FLYWHEEL_TARGET_QUOTA_EXHAUSTED all" >&2
  echo "Error: every alternate Claude profile is exhausted; Keychain/.active unchanged" >&2
  exit 32
}

capture_profile() {
  local name="$1"
  require_valid_name "$name"
  local dir="$POOL_DIR/$name" cur
  [[ -L "$POOL_DIR" ]] && fail "pool dir $POOL_DIR is a symlink — refusing"
  [[ -L "$dir" ]] && fail "profile dir $dir is a symlink — refusing"
  acquire_lock
  reconcile_before_capture "$name"
  lease_fence_or_fail
  cur=$(kc_read) || fail "no Keychain item for service '$SERVICE' — nothing to capture"
  [[ -z "$cur" ]] && fail "Keychain item for service '$SERVICE' is empty — refusing to capture"
  lease_fence_or_fail
  mkdir -p "$dir"
  chmod 700 "$POOL_DIR" "$dir"
  [[ -L "$dir/.credentials.json" ]] && fail "credential file is a symlink — refusing"
  lease_fence_or_fail
  ( umask 077; printf '%s' "$cur" > "$dir/.credentials.json.tmp" )
  lease_fence_or_fail
  mv "$dir/.credentials.json.tmp" "$dir/.credentials.json"
  chmod 600 "$dir/.credentials.json"
  echo "Captured current Keychain credential into pool profile '$name'"
  # FLY-865: snapshot the account's DISPLAY identity beside the token (or clear a
  # stale one so a fresh token is never paired with an old identity).
  capture_identity "$name"
  if [[ -n "$CAPTURE_RECOVERY_OP" ]]; then
    write_active_from_reconcile "$name" || fail "captured '$name' but could not recover .active; transition journal preserved"
    active_sync_store "$name" force || fail "captured '$name' but account-store recovery lost the lease; transition journal preserved"
    read_store_generation_for_active "$name" >/dev/null || fail "captured '$name' but account-store recovery was not committed; transition journal preserved"
    clear_transition_journal "$CAPTURE_RECOVERY_OP" || fail "captured '$name' but transition journal cleanup failed; rerun capture"
    echo "Recovered transition journal by capturing and activating profile '$name'"
    CAPTURE_RECOVERY_OP=""
  fi
}

reconcile_journal_command() {
  acquire_lock
  reconcile_transition_journal
}

# Arm the lock cleanup GLOBALLY, before any command can acquire a lock. This
# covers the FLY-852 delegated path (acquire_lock returns early without setting
# a trap) AND abnormal exits: on bash 3.2/5 the EXIT trap fires on a set -e
# abort AND on SIGINT/SIGTERM (verified), so an aborted switch never orphans the
# accounts lock or the shared ~/.claude.json.lock. Both releases no-op when
# their *_HELD flag is 0, so this is safe in delegated mode (parent owns the
# accounts lock; child never touches it).
trap cleanup_locks EXIT

case "${1:-}" in
  list)    list_profiles ;;
  status)  show_status ;;
  use)     [[ -n "${2:-}" ]] || usage; use_profile "$2" ;;
  next)    next_profile ;;
  capture) [[ -n "${2:-}" ]] || usage; capture_profile "$2" ;;
  reconcile-journal) reconcile_journal_command ;;
  *)       usage ;;
esac
