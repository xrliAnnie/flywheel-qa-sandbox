		"flywheel-voice-headphone": "workspace:*",
		"@discordjs/voice": "0.19.2",
		"ws": "8.19.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/ws": "^8.18.0",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4"
	}
