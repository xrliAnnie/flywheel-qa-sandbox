<!-- FLY-2216 — canonical Raya full-access TUI Lead TEMPLATE.
     Install only after raya-activation-preflight.sh passes. Tokens stay out of
     the plist; the fixed wrapper loads ~/.flywheel/.env. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.flywheel.lead.raya-raya</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/xiaorongli/.flywheel/bin/flywheel-codex-lead-wrapper-raya-tui-fullaccess.sh</string>
  </array>
  <key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer><key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/xiaorongli/.flywheel/logs/lead-raya-raya.log</string>
  <key>StandardErrorPath</key><string>/Users/xiaorongli/.flywheel/logs/lead-raya-raya.log</string>
</dict></plist>
