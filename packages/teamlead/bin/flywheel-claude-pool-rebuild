#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENTRY="$SCRIPT_DIR/../dist/account-heal/quota-pool-rebuild-cli.js"

if [[ ! -f "$ENTRY" ]]; then
  echo "FLYWHEEL_CLAUDE_POOL_REBUILD_UNAVAILABLE: missing $ENTRY" >&2
  exit 31
fi

exec node "$ENTRY" "$@"
