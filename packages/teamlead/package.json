{
	"name": "flywheel-teamlead",
	"version": "0.5.0",
	"description": "Flywheel bridge — REST API for Lead agent integration",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./bridge/chat-thread-utils": {
			"types": "./dist/bridge/chat-thread-utils.d.ts",
			"import": "./dist/bridge/chat-thread-utils.js"
		},
		"./v2-issue-display": {
			"types": "./dist/v2-issue-display.d.ts",
			"import": "./dist/v2-issue-display.js"
		},
		"./bridge/worktree-cleanup": {
			"types": "./dist/bridge/worktree-cleanup.d.ts",
			"import": "./dist/bridge/worktree-cleanup.js"
		},
		"./bridge/branch-cleanup": {
			"types": "./dist/bridge/branch-cleanup.d.ts",
			"import": "./dist/bridge/branch-cleanup.js"
		},
		"./bridge/cmux-close-request": {
			"types": "./dist/bridge/cmux-close-request.d.ts",
			"import": "./dist/bridge/cmux-close-request.js"
		}
	},
	"bin": {
		"teamlead": "dist/index.js",
		"flywheel-claude-freshness": "bin/flywheel-claude-freshness",
		"flywheel-claude-quota-guard": "bin/flywheel-claude-quota-guard",
		"flywheel-account-summary": "bin/flywheel-account-summary",
		"flywheel-claude-pool-rebuild": "bin/flywheel-claude-pool-rebuild",
		"flywheel-rescue-lead": "bin/flywheel-rescue-lead",
		"flywheel-quota-monitor": "bin/flywheel-quota-monitor",
		"flywheel-v2-discord-ingress": "dist/v2-discord-ingress.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"scripts": {
		"build": "tsc && rm -rf dist/static dist/workflow-seeds && cp -r static dist/static && cp -r src/workflow-seeds dist/workflow-seeds",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@linear/sdk": "60.0.0",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"better-sqlite3": "^12.8.0",
		"chokidar": "^4.0.3",
		"express": "^5.2.1",
		"flywheel-agent-team-transport": "workspace:*",
		"flywheel-claude-runner": "workspace:*",
		"flywheel-comm": "workspace:*",
		"flywheel-config": "workspace:*",
		"flywheel-core": "workspace:*",
		"flywheel-edge-worker": "workspace:*",
		"flywheel-v2-kernel": "workspace:*",
		"smol-toml": "^1.6.1",
		"sql.js": "^1.14.1",
		"ws": "^8.19.0",
		"yaml": "^2.7.1",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.6",
		"@types/node": "^20.0.0",
		"@types/sql.js": "^1.4.9",
		"@types/ws": "^8.18.0",
		"happy-dom": "^20.10.6",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4"
	}
}
