{
	"name": "flywheel-teamlead",
	"version": "0.5.0",
	"description": "Flywheel bridge \u2014 REST API for Lead agent integration",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"teamlead": "dist/index.js"
	},
	"scripts": {
		"build": "tsc && rm -rf dist/static && cp -r static dist/static",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@linear/sdk": "60.0.0",
		"better-sqlite3": "^12.8.0",
		"chokidar": "^4.0.3",
		"express": "^5.2.1",
		"flywheel-agent-team-transport": "workspace:*",
		"flywheel-claude-runner": "workspace:*",
		"flywheel-comm": "workspace:*",
		"flywheel-config": "workspace:*",
		"flywheel-core": "workspace:*",
		"flywheel-edge-worker": "workspace:*",
		"sql.js": "^1.14.1",
		"yaml": "^2.7.1",
		"ws": "^8.19.0",
		"@modelcontextprotocol/sdk": "^1.25.2",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/express": "^5.0.6",
		"@types/node": "^20.0.0",
		"@types/sql.js": "^1.4.9",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4",
		"@types/ws": "^8.18.0"
	}
}
