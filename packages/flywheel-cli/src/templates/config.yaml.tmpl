# Flywheel project config — generated by `flywheel init`.
# Edit this file to declare project metadata, Runner agents, and Lead
# routing. The `agents:` block is the source of truth for the dispatcher
# (label match) + Lead `agentName` overrides.

project:
  name: "{{PROJECT_NAME}}"
  repo: ""

linear:
  team_key: ""

runners:
  default_adapter: "tmux"

decision_layer:
  enabled: false

# agents: dispatched per Runner. Uncomment + populate as needed.
# Multi-alias `match.labels` are case-insensitive Linear labels; the
# first agent whose label set intersects the issue labels wins (within
# the issue's owning dept).
#
# Example:
#   agents:
#     backend:
#       agent_file: .flywheel/agents/product/backend-executor.md
#       department: product
#       match:
#         labels: ["backend", "api", "server"]
agents: {}
