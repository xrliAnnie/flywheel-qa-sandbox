# Flywheel project config — generated by `flywheel init`.
# Edit this file to declare project metadata and dispatch aliases. Stable node
# identity, display label, implementation file, and department ownership live
# in `.flywheel/agents/registry.yaml`.

project: "{{PROJECT_NAME}}"

linear:
  team_id: "REPLACE_ME"

runners:
  default: claude
  available:
    claude:
      type: claude

teams:
  - name: default
    orchestrators:
      - type: dag
        runner: claude
        budget_per_issue: 10

decision_layer:
  autonomy_level: advisor
  escalation_channel: discord

# Dispatch aliases reference stable node names from registry.yaml. Labels are
# case-insensitive; an empty list is name/default-only, never a wildcard.
agents:
  example:
    node: example
    match:
      labels: ["example"]
default_agent: example
