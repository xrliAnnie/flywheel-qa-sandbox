{
	"name": "flywheel-voice-bridge",
	"version": "0.1.0",
	"description": "Discord voice wiring library for voice-codex: bot registry, the DiscordDeps seam over discord.js / @discordjs/voice / prism-media, and the Lead playback speaker. The legacy voice-bridge daemon and its slash commands were retired in FLY-2860.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node ../../scripts/lib/remove-retired-dist.mjs . && tsc",
		"dev": "tsc --watch",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:run": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@discordjs/voice": "0.19.2",
		"@snazzah/davey": "0.1.12",
		"discord.js": "14.26.4",
		"flywheel-voice-core": "workspace:*",
		"opusscript": "0.0.8",
		"prism-media": "1.3.5"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4"
	}
}
