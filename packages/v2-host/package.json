{
	"name": "flywheel-v2-host",
	"version": "0.1.0",
	"description": "Flywheel v2 open-existing runtime host and authenticated IPC",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"bin": {
		"flywheel-v2-host": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "pnpm run build && vitest run",
		"test:run": "pnpm run build && vitest run",
		"test:watch": "vitest --watch",
		"typecheck": "pnpm run build"
	},
	"dependencies": {
		"flywheel-config": "workspace:*",
		"flywheel-core": "workspace:*",
		"flywheel-teamlead": "workspace:*",
		"flywheel-v2-dag": "workspace:*",
		"flywheel-v2-engine": "workspace:*",
		"flywheel-v2-kernel": "workspace:*",
		"yaml": "^2.7.1"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4"
	},
	"publishConfig": {
		"access": "public"
	}
}
