{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://flywheel.local/schema/release-manifest-view-v1.json",
	"title": "Flywheel entitled manifest view v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["latest", "versions"],
	"properties": {
		"latest": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
		},
		"versions": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["ver", "sha256"],
				"properties": {
					"ver": {
						"type": "string",
						"pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-beta\\.[1-9][0-9]*)?$"
					},
					"sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
				}
			}
		}
	}
}
