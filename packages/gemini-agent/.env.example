# flywheel-gemini-agent — env template (FLY-1018)
#
# PRODUCTION RED LINE: FLYWHEEL_GEMINI_AGENT_BRIDGE_TOKEN must ONLY ever hold
# the SCOPED token (the Bridge-side TEAMLEAD_GEMINI_AGENT_TOKEN value, M4).
# Never put the master TEAMLEAD_API_TOKEN into this process env — pre-M4 that
# combination is acceptable in test environments only.

# Master switch — default-off; every entry (CLI/daemon/delegate) refuses to
# start without it.
FLYWHEEL_GEMINI_AGENT=1

# Gemini API key (SDK standard).
GEMINI_API_KEY=

# Bridge base URL — the ONLY allowed outbound origin.
FLYWHEEL_BRIDGE_URL=http://127.0.0.1:9876

# Bearer for the 6+1 tool routes. Production: the SCOPED token value.
FLYWHEEL_GEMINI_AGENT_BRIDGE_TOKEN=

# --- optional (defaults shown) -------------------------------------------
# FLYWHEEL_GEMINI_AGENT_MODEL_TIER=flash        # flash | pro
# FLYWHEEL_GEMINI_AGENT_SURFACE=interactions    # interactions | generate
# FLYWHEEL_GEMINI_AGENT_MAX_STEPS=12
# FLYWHEEL_GEMINI_AGENT_TOKEN_BUDGET_IN=200000
# FLYWHEEL_GEMINI_AGENT_TOKEN_BUDGET_OUT=20000
# FLYWHEEL_GEMINI_AGENT_TOOL_TIMEOUT_MS=15000
# FLYWHEEL_GEMINI_AGENT_RESULT_CAP_CHARS=16000
# FLYWHEEL_GEMINI_AGENT_AUDIT_DIR=~/.flywheel/gemini-agent

# --- daemon (M2) only ------------------------------------------------------
# Discord bot token (FLY-882 pool slot — test guild / own channels only,
# never #core). Channel allowlist lives in ~/.flywheel/gemini-agent.json
# (override: FLYWHEEL_GEMINI_AGENT_CONFIG).
# FLYWHEEL_GEMINI_AGENT_DISCORD_TOKEN=

# --- Bridge side (M4, for reference — set in the BRIDGE env, not here) -----
# TEAMLEAD_GEMINI_AGENT_TOKEN=<scoped token value; must differ from
#   TEAMLEAD_API_TOKEN or the Bridge refuses to start>
