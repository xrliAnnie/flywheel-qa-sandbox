{
	"name": "flywheel-v2-dag",
	"version": "0.1.0",
	"description": "Flywheel v2 DAG admission, dispatch, completion, and generic ship runtime",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "pnpm run build && vitest run",
		"test:watch": "vitest --watch",
		"test:run": "pnpm run build && vitest run",
		"typecheck": "pnpm run build"
	},
	"dependencies": {
		"flywheel-v2-engine": "workspace:*",
		"flywheel-v2-kernel": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^5.3.3",
		"vitest": "^3.1.4"
	},
	"publishConfig": {
		"access": "public"
	}
}
