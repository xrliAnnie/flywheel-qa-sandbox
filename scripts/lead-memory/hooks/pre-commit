#!/bin/sh
set -eu

hook_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
guard=$hook_dir/lib/guard.sh
repo_root=$(git rev-parse --show-toplevel) || {
	printf 'lead-memory-guard: refusing commit: cannot resolve repository root\n' >&2
	exit 1
}

version=$(gitleaks version 2>/dev/null || true)
if [ "$version" != 8.30.1 ]; then
	printf 'lead-memory-guard: refusing commit: gitleaks 8.30.1 is required (found %s)\n' "${version:-missing}" >&2
	exit 1
fi

"$guard" check-staged
gitleaks git --pre-commit --staged \
	--config "$repo_root/.gitleaks.toml" \
	--gitleaks-ignore-path "$repo_root/.gitleaksignore"
