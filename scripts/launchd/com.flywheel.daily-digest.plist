<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FLY-727 — daily fleet-wide completion digest. This repo-owned plist remains
  policy=hold with pending-founder-optin in scripts/launchd/units.manifest: do
  not install or bootstrap it until that founder decision changes.
  Before opt-in, configure FLYWHEEL_DIGEST_CHANNEL in ~/.flywheel/.env to the
  SAME channel id as FLYWHEEL_TOKEN_USAGE_CHANNEL (the cost→dashboard channel).
  FLYWHEEL_DIGEST_CHANNEL is REQUIRED — unset means the digest is disabled (the
  Bridge also refuses to mount /api/digest when it is unset). There is NO silent
  fallback to FLYWHEEL_TOKEN_USAGE_CHANNEL.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.flywheel.daily-digest</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/xiaorongli/Dev/flywheel/scripts/daily-digest.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>FLYWHEEL_REPO</key>
		<string>/Users/xiaorongli/Dev/flywheel</string>
		<!-- FLYWHEEL_DIGEST_CHANNEL comes from ~/.flywheel/.env. -->
	</dict>
	<!--
	  Fire at 00:35 — 5 min after the 00:30 token report (which shares the
	  dashboard channel), reporting the day that just ended with complete data.
	-->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>0</integer>
		<key>Minute</key>
		<integer>35</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/flywheel-daily-digest.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/flywheel-daily-digest.err</string>
</dict>
</plist>
