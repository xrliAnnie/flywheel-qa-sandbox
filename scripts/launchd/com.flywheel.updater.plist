<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.flywheel.updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/xiaorongli/Dev/flywheel/scripts/update-flywheel.sh</string>
    </array>
    <!-- FLY-299: launchd's default PATH lacks /usr/local/bin, so restart-services.sh's
         `pnpm install`/`pnpm build` fail with 'pnpm: command not found' during the
         detached deploy. Pin a PATH that resolves pnpm/node (/usr/local/bin),
         git/jq (/usr/bin), launchctl (/bin), + homebrew + user bins. Absolute paths. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/Users/xiaorongli/.local/bin:/Users/xiaorongli/.npm-global/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- FLY-1959: only founder-authorized emergency tokens trigger this job.
         Ordinary merges publish nothing and never start updater. A token that
         arrives during a running invocation remains for the next instance.
         Absolute host-pinned path required (no '~'). -->
    <key>QueueDirectories</key>
    <array>
        <string>/Users/xiaorongli/.flywheel/self-ship-urgent.d</string>
    </array>
    <!-- Scheduled shuttle: deploy once when deployed-sha trails origin/main. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>0</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>12</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>
    <!-- Bound distinct emergency launches to at most one per minute. -->
    <key>ThrottleInterval</key><integer>60</integer>
    <key>StandardOutPath</key><string>/tmp/flywheel-updater.log</string>
    <key>StandardErrorPath</key><string>/tmp/flywheel-updater.log</string>
</dict>
</plist>
