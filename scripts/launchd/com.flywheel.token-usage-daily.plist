<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FLY-614 — daily token-usage report. This repo-owned plist is registered as
  policy=copy in scripts/launchd/units.manifest; its declared host prefix and
  checked-in bytes are authoritative, so do not hand-edit an installed copy.
  The channel is supplied via FLYWHEEL_TOKEN_USAGE_CHANNEL in ~/.flywheel/.env.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.flywheel.token-usage-daily</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/xiaorongli/Dev/flywheel/scripts/token-usage-daily.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>FLYWHEEL_REPO</key>
		<string>/Users/xiaorongli/Dev/flywheel</string>
		<!-- FLYWHEEL_TOKEN_USAGE_CHANNEL comes from ~/.flywheel/.env. -->
	</dict>
	<!--
	  FLY-713: fire at 00:30 (just past midnight) so the report — which renders
	  YESTERDAY's full day — is sent with the freshest complete data. 00:30 is a
	  clean gap clear of the 00:00 updater and the 01:00 / 03:00 / 03:07 cron jobs.
	  (FLY-744 note: the issue says "00:35"; that's an approximation — the actual,
	  deliberately-chosen slot is 00:30. Kept as-is to preserve the clean cron gap.)
	-->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>0</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/flywheel-token-usage-daily.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/flywheel-token-usage-daily.err</string>
</dict>
</plist>
