<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FLY-1082 (Task 3.3) — OUT-OF-PROCESS Bridge liveness probe.

  Runs scripts/bridge-liveness-probe.sh every minute: curls the Bridge /health,
  counts consecutive down minutes in a state file, and pages @Annie over
  Discord ONCE per down episode after FLYWHEEL_BRIDGE_DOWN_ESCALATE_MIN
  (default 5) minutes — the "Bridge died and never came back" backstop the
  2026-07-09 incident exposed (every in-Bridge detector died with the Bridge).

  This repo-owned plist is registered as policy=copy in
  scripts/launchd/units.manifest; its declared host prefix and checked-in bytes
  are authoritative. It belongs in the CODEX Infra Bot's launchd domain
  ("nobody rescues their own side"). The probe posts with the Codex bot's token,
  loaded from ~/.flywheel/.env rather than pasted here, so it works while the
  whole Claude/Bridge side is down.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.flywheel.bridge-liveness-probe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<!-- Source the shared env (bot token etc.) then run the probe — tokens
		     never live in this plist. -->
		<string>set -a; [ -f "$HOME/.flywheel/.env" ] &amp;&amp; . "$HOME/.flywheel/.env"; set +a; exec /Users/xiaorongli/Dev/flywheel/scripts/bridge-liveness-probe.sh</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- Paging values are resolved from ~/.flywheel/.env. Required names:
		FLYWHEEL_UNIFIED_ALERT_CHANNEL_ID and FLYWHEEL_FOUNDER_DISCORD_USER_ID.
		Optional names: BRIDGE_URL (default http://localhost:9876),
		FLYWHEEL_BRIDGE_DOWN_ESCALATE_MIN (default 5), and
		FLYWHEEL_PROBE_BOT_TOKEN_ENV (default CODEX_INFRA_BOT_TOKEN).
		-->
	</dict>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/flywheel-bridge-liveness-probe.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/flywheel-bridge-liveness-probe.err</string>
</dict>
</plist>
