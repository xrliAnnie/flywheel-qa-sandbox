<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FLY-697 — Codex TRACE-log SSD-wear monitor (launchd template).

  Runs `codex-log-guard.sh monitor` once a day (READ-ONLY): appends the
  ~/.codex/logs_2.sqlite size to a rolling log and fires a debounced meta-alert
  if the file crosses the bloat threshold (re-growth guard). It NEVER writes the
  DB — the actual TRACE-trigger install + VACUUM are operator-run while Codex is
  quit (see doc/engineer/implementation/codex-log-bloat-guard.md).

  Install:
    cp scripts/launchd/com.flywheel.codex-log-guard.plist ~/Library/LaunchAgents/
    # edit the script path / Hour / Minute below to match this machine, then:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.flywheel.codex-log-guard.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.flywheel.codex-log-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/xiaorongli/Dev/flywheel/scripts/codex-log-guard.sh</string>
		<string>monitor</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<!-- Optional overrides (defaults shown):
		<key>CODEX_LOG_GUARD_THRESHOLD_BYTES</key><string>268435456</string>
		<key>CODEX_LOG_GUARD_LEVELS</key><string>TRACE</string>
		-->
	</dict>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>15</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/tmp/flywheel-codex-log-guard.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/flywheel-codex-log-guard.err</string>
</dict>
</plist>
