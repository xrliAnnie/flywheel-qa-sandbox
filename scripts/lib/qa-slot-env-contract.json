		"name": "FLYWHEEL_KILL_LEDGER_ROOT",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/kill-ledger",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_REPORTS_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/reports",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_COMPLETE_MARKER_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/complete-failed",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_LOOP_DIAGNOSTICS_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/loop-diagnostics",
		"boot": "mustBeUnderRoot"
	},
