[
	{
		"name": "FLYWHEEL_ISOLATION_ROOT",
		"disposition": "redirect",
		"value": "${SLOT_DIR}",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_ISOLATION_CONTRACT",
		"disposition": "redirect",
		"value": "${REPO_ROOT}/scripts/lib/qa-slot-env-contract.json",
		"boot": "unchecked"
	},
	{
		"name": "FLYWHEEL_STATE_DIR",
		"unconfinedConsumers": [
			{
				"coordinate": "$HOME/.flywheel/state/launch-commits/<executionId>",
				"consumers": [
					"run-dispatcher.launchCommitPath",
					"WorkflowEngineDispatcher.stateRoot"
				],
				"reason": "Legacy launch-commit records ignore FLYWHEEL_STATE_DIR; explicitly unconfined by Lead ruling 38377789. Boot validates the env value, not these consumers. Path refactor deferred."
			}
		],
		"disposition": "redirect",
		"value": "${SLOT_DIR}",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "TEAMLEAD_DB_PATH",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/teamlead.db",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_COMM_ROOT",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/comm",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_CODEX_HOMES_ROOT",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/codex-homes",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_CODEX_SESSION_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/codex-sessions",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_CODEX_DAEMON_SOCKET_ROOT",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/cdx-sock",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "CODEX_HOME",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/codex-home",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "TMUX_TMPDIR",
		"confinedConsumers": [
			"codex-runner-tui-window.defaultEnsureSessionAsync (explicit -S via tmuxSocketPath)"
		],
		"disposition": "redirect",
		"value": "${SLOT_DIR}",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "TMPDIR",
		"disposition": "redirect",
		"value": "${SLOT_TMPDIR}",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_DELIVERY_SECRET_PATH",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/delivery-secret",
		"boot": "mustBeUnderRoot"
	},
