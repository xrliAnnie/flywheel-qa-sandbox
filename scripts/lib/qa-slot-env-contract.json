		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/founder-consent-audit.db",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_BIN_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/bin",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_HOOKS_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/hooks",
		"boot": "mustBeUnderRoot"
	},
	{
		"name": "FLYWHEEL_IDENTITY_FAILURE_DIR",
		"disposition": "redirect",
		"value": "${SLOT_DIR}/state/lead-identity-failures",
		"boot": "mustBeUnderRoot"
	},
	{ "name": "TMUX", "disposition": "clear", "boot": "mustBeAbsent" },
	{ "name": "TMUX_PANE", "disposition": "clear", "boot": "mustBeAbsent" },
	{
		"name": "FLYWHEEL_TMUX_SOCKET_OVERRIDE",
		"disposition": "clear",
		"boot": "mustBeAbsent"
	},
	{
		"name": "FLYWHEEL_COMM_DB",
		"disposition": "clear",
		"boot": "mustBeAbsent"
	},
	{
		"name": "FLYWHEEL_COMM_DIR",
		"disposition": "clear",
		"boot": "mustBeAbsent"
	},
	{
		"name": "FLYWHEEL_BRIDGE_LOG_PATH",
		"disposition": "clear",
		"boot": "mustBeUnderRootIfSet"
	},
	{
		"name": "FLYWHEEL_BRIDGE_LOG_ERROR_MARKER",
		"disposition": "clear",
		"boot": "mustBeUnderRootIfSet"
	},
	{
		"name": "FLYWHEEL_BRIDGE_RAW_STARTUP_LOG",
		"disposition": "clear",
		"boot": "mustBeUnderRootIfSet"
	},
	{ "name": "FLYWHEEL_QA_NODE", "disposition": "clear", "boot": "unchecked" },
	{ "name": "VERCEL_TOKEN", "disposition": "clear", "boot": "unchecked" },
	{
		"name": "FLYWHEEL_REPORT_HOST_OVERRIDE_URL",
		"disposition": "clear",
		"boot": "unchecked"
	},
	{
		"name": "FLYWHEEL_ROUNDTABLE_CHANNEL_ID",
		"disposition": "clear",
		"boot": "unchecked"
	},
	{
		"name": "FLYWHEEL_ROUNDTABLE_REPLY_IN_THREAD",
		"disposition": "clear",
		"boot": "unchecked"
	},
	{
		"name": "GH_TOKEN",
		"disposition": "passthrough",
		"reason": "GitHub CLI credential required by the slot checkout workflow",
		"boot": "unchecked"
	},
	{
		"name": "GITHUB_TOKEN",
		"disposition": "passthrough",
		"reason": "GitHub CLI credential alias required by the slot checkout workflow",
		"boot": "unchecked"
	},
	{
		"name": "HOME",
		"disposition": "passthrough",
		"reason": "Host account root is required to locate explicit QA configuration",
		"boot": "unchecked"
	},
	{
		"name": "PATH",
		"disposition": "passthrough",
		"reason": "The slot launcher requires the host toolchain executables",
		"boot": "unchecked"
	}
]
