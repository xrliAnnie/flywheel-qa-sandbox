<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- FLY-2137: rendered and installed only by install-calendar-sweep.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.flywheel.calendar-sweep</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NODE_BIN__</string>
        <string>__REPO_ROOT__/scripts/calendar-write-sweep.mjs</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>FLYWHEEL_REPO</key>
        <string>__REPO_ROOT__</string>
        <key>PATH</key>
        <string>__HOME__/.npm-global/bin:__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/flywheel/calendar-sweep.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/flywheel/calendar-sweep.err.log</string>
</dict>
</plist>
